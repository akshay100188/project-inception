  "metadata": {
    "github_url": "https://github.com/vendurehq/vendure",
    "stars": 8144,
    "domain": "ecommerce",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "React (admin dashboard)",
      "backend": "Node.js, NestJS, TypeScript, GraphQL",
      "database": "TypeORM (supports SQL databases)",
      "infrastructure": "Node.js host-agnostic (Docker, Kubernetes, cloud, self-hosted)",
      "key_libraries": [
        "NestJS",
        "GraphQL",
        "TypeORM",
        "Lerna",
        "gql-tada",
        "ESLint",
        "Prettier",
        "ts-node",
        "Bun"
      ]
    },
    "raw_profile": {
      "project_name": "Vendure",
      "problem_statement": "Teams building e-commerce platforms must choose between rigid SaaS solutions or assembling a DIY stack of services. Vendure provides an open-source, headless TypeScript commerce backend that is fully extensible via plugins without requiring core forks.",
      "target_users": [
        "Enterprise e-commerce development teams",
        "Backend/full-stack developers building custom storefronts",
        "Agencies building headless commerce solutions",
        "Teams requiring multi-channel commerce infrastructure"
      ],
      "core_features": [
        {
          "feature": "GraphQL API for both storefront (shop) and admin channels",
          "priority": "must-have"
        },
        {
          "feature": "Plugin architecture for extending or overriding core behavior without patching",
          "priority": "must-have"
        },
        {
          "feature": "Built-in commerce primitives: catalog, orders, customers, promotions, tax, shipping, payments, stock",
          "priority": "must-have"
        },
        {
          "feature": "React-based admin dashboard",
          "priority": "must-have"
        },
        {
          "feature": "Multi-channel support from a single backend",
          "priority": "must-have"
        },
        {
          "feature": "Official plugins: email, asset server, job queue, security hardening, telemetry",
          "priority": "nice-to-have"
        },
        {
          "feature": "CLI tooling for generating plugins and migrations",
          "priority": "nice-to-have"
        },
        {
          "feature": "E2E test harness with programmable mock server",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Vendure Cloud (managed hosting)",
        "GraphiQL (API explorer plugin)",
        "Docker / Kubernetes (deployment targets)"
      ],
      "scale": "large",
      "domain": "ecommerce",
      "tech_stack": {
        "frontend": "React (admin dashboard)",
        "backend": "Node.js, NestJS, TypeScript, GraphQL",
        "database": "TypeORM (supports SQL databases)",
        "infrastructure": "Node.js host-agnostic (Docker, Kubernetes, cloud, self-hosted)",
        "key_libraries": [
          "NestJS",
          "GraphQL",
          "TypeORM",
          "Lerna",
          "gql-tada",
          "ESLint",
          "Prettier",
          "ts-node",
          "Bun"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Plugin-first design allows extending or overriding any part of the system through stable contracts, avoiding the need to fork the core codebase.",
        "Lerna monorepo structure cleanly separates core framework, official plugins, dashboard, CLI, and testing harness into independently versioned packages.",
        "Dual GraphQL API surface (shop API and admin API) separates customer-facing and administrative concerns at the API layer.",
        "Code generation (gql-tada, GraphQL type codegen) is built into the development workflow to maintain end-to-end type safety across the TypeScript stack."
      ]
    }
  }
}