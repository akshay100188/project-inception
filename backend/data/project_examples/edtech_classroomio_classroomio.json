  "metadata": {
    "github_url": "https://github.com/classroomio/classroomio",
    "stars": 1546,
    "domain": "edtech",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "SvelteKit, Svelte, TailwindCSS",
      "backend": "Hono, Node.js",
      "database": "PostgreSQL",
      "infrastructure": "Docker, Redis, Turbo monorepo",
      "key_libraries": [
        "Better Auth",
        "TailwindCSS",
        "Prettier",
        "Lefthook",
        "Turbo"
      ]
    },
    "raw_profile": {
      "project_name": "ClassroomIO",
      "problem_statement": "ClassroomIO is an open-source learning management system that provides a simple, beautiful alternative to proprietary platforms like Moodle, EdX, and Teachable. It empowers bootcamps, educators, and businesses to manage training programs and deliver high-quality education at scale without vendor lock-in.",
      "target_users": [
        "Bootcamp instructors",
        "Corporate trainers",
        "Independent educators",
        "Educational organizations",
        "Companies running internal training programs"
      ],
      "core_features": [
        {
          "feature": "Advanced Course Management (unlimited courses, lessons, assignments, grading, certificates)",
          "priority": "must-have"
        },
        {
          "feature": "Multi-teacher organization management with course assignment",
          "priority": "must-have"
        },
        {
          "feature": "AI-powered course content generation using OpenAI",
          "priority": "nice-to-have"
        },
        {
          "feature": "Community forum for student questions and peer support",
          "priority": "must-have"
        },
        {
          "feature": "Mobile-first student dashboard with course access",
          "priority": "must-have"
        },
        {
          "feature": "Self-hosting capability with full open-source stack",
          "priority": "must-have"
        }
      ],
      "integrations": [
        "OpenAI (course and assignment generation)",
        "Better Auth (authentication)",
        "Hono (HTTP framework)"
      ],
      "scale": "medium",
      "domain": "edtech",
      "tech_stack": {
        "frontend": "SvelteKit, Svelte, TailwindCSS",
        "backend": "Hono, Node.js",
        "database": "PostgreSQL",
        "infrastructure": "Docker, Redis, Turbo monorepo",
        "key_libraries": [
          "Better Auth",
          "TailwindCSS",
          "Prettier",
          "Lefthook",
          "Turbo"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Monorepo strategy (Turbo) enables modular separation of concerns: website, dashboard, API, docs, and shared packages (db, utils, ui) for code reuse",
        "Full-stack TypeScript adoption across frontend (Svelte/SvelteKit) and backend (Hono) reduces context switching and improves type safety",
        "Self-hosting capability is a core differentiator; architecture supports both cloud and on-premise deployments via environment configuration and license keys",
        "Multi-tenant design with organization and course-level permissions built in; asynchronous job processing (Redis/jobs-worker) handles resource-intensive tasks like PDF/video processing separately"
      ]
    }
  }
}