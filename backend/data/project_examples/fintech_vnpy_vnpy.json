    "raw_profile": {
      "project_name": "VeighNa (vnpy)",
      "problem_statement": "Provides an open-source Python framework for building quantitative trading systems with multi-market gateway support, strategy backtesting, and AI-powered machine learning capabilities for professional traders and financial institutions.",
      "target_users": [
        "Quantitative traders",
        "Hedge funds and private equity firms",
        "Securities brokerages",
        "Futures companies",
        "Institutional investors",
        "Algo trading developers"
      ],
      "core_features": [
        {
          "feature": "Multi-gateway trading interface supporting 30+ domestic and international exchanges",
          "priority": "must-have"
        },
        {
          "feature": "CTA strategy engine with fine-grained order control for low-latency trading",
          "priority": "must-have"
        },
        {
          "feature": "AI-powered Alpha module with ML-based factor engineering and multi-algorithm model training",
          "priority": "must-have"
        },
        {
          "feature": "Strategy backtesting framework with parameter optimization and performance analysis",
          "priority": "must-have"
        },
        {
          "feature": "Spread trading module with custom spread definitions and algorithmic trading",
          "priority": "nice-to-have"
        },
        {
          "feature": "Options trading module with pricing models and Greeks risk tracking",
          "priority": "nice-to-have"
        },
        {
          "feature": "Portfolio strategy management for multi-asset coordination",
          "priority": "nice-to-have"
        },
        {
          "feature": "RPC service for distributed system architecture support",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Interactive Brokers",
        "CTP (China Futures Market)",
        "RQData market data service",
        "RQData historical data service",
        "XunTou market data service",
        "Multiple domestic Chinese brokers (CTP Mini, Femas, Esunny, XTP, Tora, etc.)",
        "International futures providers (TAP, DA)"
      ],
      "scale": "large",
      "domain": "fintech",
      "tech_stack": {
        "frontend": "PySide6 (Qt6), PyQtGraph, Plotly",
        "backend": "Python 3.10+",
        "database": null,
        "infrastructure": "ZMQ for distributed messaging, RPC service architecture",
        "key_libraries": [
          "pandas",
          "numpy",
          "scikit-learn",
          "LightGBM",
          "PyTorch",
          "ta-lib",
          "DEAP (genetic algorithms)",
          "Loguru",
          "Polars",
          "Alphalens",
          "PyArrow"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Modular plugin-based gateway architecture enables seamless integration with 30+ trading venues while maintaining core framework stability",
        "Strategy-agnostic event-driven design allows CTA, spread, options, and portfolio strategies to coexist on same trading infrastructure",
        "AI-powered Alpha module follows Qlib's pattern of unified ML pipeline (dataset \u2192 model \u2192 strategy \u2192 lab) to reduce barrier for quant researchers",
        "Cross-platform support (Windows/Linux/macOS) and multi-Python version compatibility (3.10-3.13) achieved through careful dependency pinning and type hints"
      ]
    }
