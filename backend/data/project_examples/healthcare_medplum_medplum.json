  "metadata": {
    "github_url": "https://github.com/medplum/medplum",
    "stars": 2369,
    "domain": "healthcare",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "React with TypeScript",
      "backend": "Node.js with Express and TypeScript",
      "database": "PostgreSQL",
      "infrastructure": "AWS (Lambda, CDK), Redis for caching and background jobs",
      "key_libraries": [
        "Express",
        "React",
        "TypeScript",
        "PostgreSQL",
        "Redis",
        "Jest",
        "Turbo",
        "Babel",
        "ESBuild"
      ]
    },
    "raw_profile": {
      "project_name": "Medplum",
      "problem_statement": "Medplum is a developer platform that enables rapid development of compliant healthcare applications by providing FHIR-based infrastructure, authentication, clinical data repository, and pre-built UI components.",
      "target_users": [
        "Healthcare software developers",
        "Healthcare organizations",
        "EHR/EMR system builders",
        "Healthcare app developers"
      ],
      "core_features": [
        {
          "feature": "FHIR-based Clinical Data Repository (CDR)",
          "priority": "must-have"
        },
        {
          "feature": "OAuth/OpenID/SMART-on-FHIR Authentication",
          "priority": "must-have"
        },
        {
          "feature": "GraphQL and REST API for healthcare data",
          "priority": "must-have"
        },
        {
          "feature": "Medplum Bots for server-side application logic",
          "priority": "must-have"
        },
        {
          "feature": "React UI component library for healthcare apps",
          "priority": "must-have"
        },
        {
          "feature": "Web application for data viewing and workflow management",
          "priority": "nice-to-have"
        },
        {
          "feature": "On-premise agent for hybrid deployments",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "FHIR standard",
        "SMART-on-FHIR",
        "OAuth 2.0 / OpenID Connect",
        "AWS Lambda",
        "AWS CDK"
      ],
      "scale": "large",
      "domain": "healthcare",
      "tech_stack": {
        "frontend": "React with TypeScript",
        "backend": "Node.js with Express and TypeScript",
        "database": "PostgreSQL",
        "infrastructure": "AWS (Lambda, CDK), Redis for caching and background jobs",
        "key_libraries": [
          "Express",
          "React",
          "TypeScript",
          "PostgreSQL",
          "Redis",
          "Jest",
          "Turbo",
          "Babel",
          "ESBuild"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Monorepo structure with Turbo for build orchestration enables managing multiple interconnected packages (core, app, server, CLI, bots) from a single repository",
        "Heavy emphasis on compliance and standards: FHIR adherence, HIPAA compliance, SOC2 certification, and OpenSSF Best Practices demonstrate healthcare-grade security and governance",
        "Full-stack TypeScript strategy reduces context switching and enables code sharing between frontend and backend, particularly evident in shared core library and type definitions",
        "Extensibility through Bots and serverless Lambda integration allows customers to add custom business logic without managing infrastructure"
      ]
    }
  }
}