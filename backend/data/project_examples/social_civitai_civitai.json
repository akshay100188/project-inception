  "metadata": {
    "github_url": "https://github.com/civitai/civitai",
    "stars": 7117,
    "domain": "social",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Next.js (React), Mantine UI, SCSS",
      "backend": "Next.js API routes, tRPC",
      "database": "PostgreSQL with Prisma ORM, PLpgSQL stored procedures",
      "infrastructure": "Docker, Cloudflare, MinIO/S3, Meilisearch",
      "key_libraries": [
        "trpc",
        "prisma",
        "mantine",
        "next.js",
        "zod",
        "pnpm"
      ]
    },
    "raw_profile": {
      "project_name": "Civitai",
      "problem_statement": "Civitai provides a social platform for sharing, discovering, and collaborating on AI image generation models (Stable Diffusion checkpoints, textual inversions, LoRAs, etc.). It enables creators to upload, rate, and comment on models while building a community around AI-generated art.",
      "target_users": [
        "AI art creators and hobbyists",
        "Stable Diffusion model developers",
        "Researchers exploring generative AI",
        "Artists customizing AI image generation workflows"
      ],
      "core_features": [
        {
          "feature": "Model upload, versioning, and hosting with S3/Cloudflare storage",
          "priority": "must-have"
        },
        {
          "feature": "User accounts, profiles, and social interactions (comments, ratings, follows)",
          "priority": "must-have"
        },
        {
          "feature": "Model browsing, search, and filtering via Meilisearch",
          "priority": "must-have"
        },
        {
          "feature": "Image gallery showcasing AI-generated outputs tied to models",
          "priority": "must-have"
        },
        {
          "feature": "Content moderation system with moderator roles",
          "priority": "must-have"
        },
        {
          "feature": "Metrics and analytics tracking for model engagement",
          "priority": "nice-to-have"
        },
        {
          "feature": "Webhook integration for event-driven notifications",
          "priority": "nice-to-have"
        },
        {
          "feature": "Buzz (virtual currency) and signals service for community engagement",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Cloudflare (storage and CDN)",
        "AWS S3 / MinIO (file storage)",
        "Meilisearch (full-text search)",
        "Maildev / SMTP email",
        "Discord",
        "GitHub Container Registry (ghcr.io)"
      ],
      "scale": "large",
      "domain": "social",
      "tech_stack": {
        "frontend": "Next.js (React), Mantine UI, SCSS",
        "backend": "Next.js API routes, tRPC",
        "database": "PostgreSQL with Prisma ORM, PLpgSQL stored procedures",
        "infrastructure": "Docker, Cloudflare, MinIO/S3, Meilisearch",
        "key_libraries": [
          "trpc",
          "prisma",
          "mantine",
          "next.js",
          "zod",
          "pnpm"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Full-stack TypeScript monorepo using Next.js for both frontend and backend simplifies deployment while tRPC provides end-to-end type safety across the API boundary",
        "Heavy use of PLpgSQL stored procedures alongside Prisma ORM suggests performance-critical database logic is pushed down to the database layer for metrics and aggregations",
        "Docker-based local development with devcontainer support and a Makefile automation layer lowers contributor onboarding friction significantly",
        "Separation of specialized services (buzz/signals) into internal microservices behind a container registry indicates selective extraction of high-throughput features from the monolith"
      ]
    }
  }
}