  "metadata": {
    "github_url": "https://github.com/nocobase/nocobase",
    "stars": 22476,
    "domain": "productivity",
    "primary_language": "TypeScript",
    "architecture_pattern": "microservices",
    "tech_stack": {
      "frontend": "React 18, Ant Design 5, Formily",
      "backend": "Node.js (>=18), TypeScript",
      "database": "Relational databases (abstracted via ORM, supports external DBs)",
      "infrastructure": "Docker, self-hosted, Lerna monorepo, Yarn workspaces",
      "key_libraries": [
        "antd",
        "@formily/antd-v5",
        "react-router-dom",
        "lerna",
        "tsx",
        "dotenv",
        "tsconfig-paths",
        "eslint",
        "@typescript-eslint/parser"
      ]
    },
    "raw_profile": {
      "project_name": "NocoBase",
      "problem_statement": "Building business systems (CRM, ERP, internal tools) traditionally requires significant development time and expertise. NocoBase provides an AI-augmented no-code platform that combines WYSIWYG visual building with AI coding agents to accelerate business system creation while maintaining reliability through production-proven infrastructure.",
      "target_users": [
        "Business operators and non-technical users",
        "Developers and AI coding agents",
        "Enterprise IT teams building internal tools",
        "SMBs needing CRM, ERP, or project management systems",
        "Self-hosted solution adopters"
      ],
      "core_features": [
        {
          "feature": "WYSIWYG no-code interface for building data models, pages, workflows, and permissions",
          "priority": "must-have"
        },
        {
          "feature": "AI coding agent integration (Claude Code, Cursor, Codex, OpenCode, TRAE)",
          "priority": "must-have"
        },
        {
          "feature": "Plugin-based microkernel architecture for extensibility",
          "priority": "must-have"
        },
        {
          "feature": "Built-in workflow automation engine",
          "priority": "must-have"
        },
        {
          "feature": "Fine-grained role-based permissions with field-level access control and audit logs",
          "priority": "must-have"
        },
        {
          "feature": "AI employees integrated into business workflows for task automation",
          "priority": "nice-to-have"
        },
        {
          "feature": "External agent connectivity via MCP, HTTP APIs, and CLI",
          "priority": "nice-to-have"
        },
        {
          "feature": "Multi-source data model support (main DB, external DBs, third-party APIs)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Claude Code",
        "Cursor",
        "Codex",
        "OpenCode",
        "TRAE",
        "OpenClaw",
        "Hermes",
        "Dify",
        "Coze",
        "n8n",
        "Telegram",
        "WhatsApp",
        "Slack",
        "Gmail",
        "MCP (Model Context Protocol)"
      ],
      "scale": "large",
      "domain": "productivity",
      "tech_stack": {
        "frontend": "React 18, Ant Design 5, Formily",
        "backend": "Node.js (>=18), TypeScript",
        "database": "Relational databases (abstracted via ORM, supports external DBs)",
        "infrastructure": "Docker, self-hosted, Lerna monorepo, Yarn workspaces",
        "key_libraries": [
          "antd",
          "@formily/antd-v5",
          "react-router-dom",
          "lerna",
          "tsx",
          "dotenv",
          "tsconfig-paths",
          "eslint",
          "@typescript-eslint/parser"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Microkernel plugin architecture allows everything to be a plugin, enabling sustainable system growth without architectural degradation",
        "Data-model driven design decouples business data (stored in standard relational structures) from UI, preventing platform lock-in and keeping AI outputs transparent",
        "Monorepo with Lerna and Yarn workspaces manages a large multi-package TypeScript codebase across hundreds of plugins and core packages",
        "AI and human collaboration is treated as a first-class design concern, with shared permissions and audit infrastructure governing both human and AI agent actions equally"
      ]
    }
  }
}