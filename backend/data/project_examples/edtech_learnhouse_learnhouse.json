    "raw_profile": {
      "project_name": "LearnHouse",
      "problem_statement": "LearnHouse is an open-source learning management platform that enables educators and organizations to create, manage, and deliver world-class educational content with modern features like AI-powered tools, code execution, real-time collaboration, and analytics.",
      "target_users": [
        "Educators and instructors",
        "Educational institutions",
        "Organizations and enterprises",
        "Course creators",
        "Learning administrators"
      ],
      "core_features": [
        {
          "feature": "Course creation and management with block-based Notion-like editor",
          "priority": "must-have"
        },
        {
          "feature": "AI-powered interactive elements, simulations, and diagrams (Playgrounds)",
          "priority": "must-have"
        },
        {
          "feature": "Code execution with auto-grading in 30+ languages",
          "priority": "must-have"
        },
        {
          "feature": "Real-time collaborative whiteboards (Boards)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Student assignments tracking and submission management",
          "priority": "must-have"
        },
        {
          "feature": "Analytics and engagement tracking dashboard",
          "priority": "must-have"
        },
        {
          "feature": "Community discussions and forums",
          "priority": "nice-to-have"
        },
        {
          "feature": "Podcast content support and certificate generation",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Google Gemini AI",
        "Stripe (payments)",
        "OAuth providers (SSO)",
        "Docker (deployment)",
        "PostgreSQL (database)",
        "Redis (caching/sessions)"
      ],
      "scale": "medium",
      "domain": "edtech",
      "tech_stack": {
        "frontend": "Next.js, React, TypeScript, TailwindCSS, Radix UI, Tiptap, CodeMirror, Yjs",
        "backend": "FastAPI, Python",
        "database": "PostgreSQL, Redis",
        "infrastructure": "Docker, self-hostable with CLI",
        "key_libraries": [
          "Next.js",
          "React",
          "TypeScript",
          "TailwindCSS",
          "Radix UI",
          "Tiptap",
          "Yjs",
          "CodeMirror",
          "FastAPI",
          "Stripe",
          "Google Gemini"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Polyglot full-stack approach: TypeScript/React frontend with Python FastAPI backend enables specialized tooling for each domain (UI frameworks vs. ML/AI integration)",
        "Real-time collaboration is core: Yjs integration for whiteboards and collaborative features indicates strong emphasis on synchronous learning experiences",
        "AI-first design: Context-aware AI components throughout (code execution, content generation, playgrounds) show AI as a platform capability rather than an add-on",
        "Self-hosting and developer experience prioritized: Custom CLI tool for setup, deployment, and management reduces friction for institutional adoption and self-hosting"
      ]
    }
  }
