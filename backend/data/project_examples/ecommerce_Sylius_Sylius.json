  "metadata": {
    "github_url": "https://github.com/Sylius/Sylius",
    "stars": 8473,
    "domain": "ecommerce",
    "primary_language": "PHP",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Twig, SCSS, JavaScript, Symfony UX / Stimulus, Tom Select",
      "backend": "PHP, Symfony Framework",
      "database": "Doctrine ORM (implied by Symfony/Sylius stack)",
      "infrastructure": "Docker, Makefile, Shell scripts",
      "key_libraries": [
        "API Platform",
        "PHPUnit",
        "Behat",
        "Symfony UX Live Component",
        "Symfony UX Autocomplete",
        "@hotwired/stimulus",
        "tom-select",
        "Webpack Encore"
      ]
    },
    "raw_profile": {
      "project_name": "Sylius",
      "problem_statement": "Sylius provides an open-source, headless eCommerce framework built on PHP/Symfony that enables developers to build highly customized online stores with a powerful REST API. It addresses the need for a flexible, developer-friendly eCommerce solution that avoids the rigidity of traditional monolithic shop platforms.",
      "target_users": [
        "eCommerce developers",
        "PHP/Symfony developers",
        "Digital agencies building custom online stores",
        "Businesses requiring tailored eCommerce solutions",
        "B2B eCommerce operators"
      ],
      "core_features": [
        {
          "feature": "Headless eCommerce with REST API (API Platform)",
          "priority": "must-have"
        },
        {
          "feature": "Product catalog and inventory management",
          "priority": "must-have"
        },
        {
          "feature": "Shopping cart and checkout process",
          "priority": "must-have"
        },
        {
          "feature": "Order management and fulfillment",
          "priority": "must-have"
        },
        {
          "feature": "Admin panel for store management",
          "priority": "must-have"
        },
        {
          "feature": "Plugin/extension system via Sylius Store",
          "priority": "nice-to-have"
        },
        {
          "feature": "Multi-store and multi-channel support (Plus)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Loyalty system and returns handling (Plus)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "API Platform",
        "Symfony UX Autocomplete",
        "Symfony UX Live Component",
        "Hotwire Stimulus",
        "Packagist (sylius-plugin ecosystem)"
      ],
      "scale": "large",
      "domain": "ecommerce",
      "tech_stack": {
        "frontend": "Twig, SCSS, JavaScript, Symfony UX / Stimulus, Tom Select",
        "backend": "PHP, Symfony Framework",
        "database": "Doctrine ORM (implied by Symfony/Sylius stack)",
        "infrastructure": "Docker, Makefile, Shell scripts",
        "key_libraries": [
          "API Platform",
          "PHPUnit",
          "Behat",
          "Symfony UX Live Component",
          "Symfony UX Autocomplete",
          "@hotwired/stimulus",
          "tom-select",
          "Webpack Encore"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "BDD-first development culture: the large Gherkin test suite (1.5MB) indicates full-stack Behavior-Driven Development is a first-class concern, not an afterthought.",
        "Symfony Bundle modularization: the codebase is split into discrete Symfony Bundles (AdminBundle, ShopBundle, etc.), enabling consumers to use only the components they need.",
        "Headless-first API design using API Platform allows the same backend to power diverse frontends (web, mobile, third-party integrations) without coupling to a single rendering layer.",
        "Commercial Plus tier layered on open-source core: advanced features (multi-store, B2B, loyalty) are offered as paid modules, demonstrating an open-core business model pattern."
      ]
    }
  }
}