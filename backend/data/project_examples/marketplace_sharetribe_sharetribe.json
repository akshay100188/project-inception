        "cucumber-rails",
        "factory_bot"
      ]
    },
    "raw_profile": {
      "project_name": "Sharetribe Go",
      "problem_statement": "Sharetribe Go is a source-available marketplace platform that enables users to build and launch peer-to-peer and sharing economy marketplaces. It provides a complete solution for creating online marketplaces without requiring extensive coding.",
      "target_users": [
        "Marketplace entrepreneurs",
        "Platform builders",
        "Small to medium marketplace operators",
        "Developers extending marketplace functionality"
      ],
      "core_features": [
        {
          "feature": "User authentication and profiles",
          "priority": "must-have"
        },
        {
          "feature": "Listing creation and management",
          "priority": "must-have"
        },
        {
          "feature": "Search and discovery with Sphinx indexing",
          "priority": "must-have"
        },
        {
          "feature": "Payment processing integration",
          "priority": "must-have"
        },
        {
          "feature": "WYSIWYG custom landing page builder",
          "priority": "nice-to-have"
        },
        {
          "feature": "Third-party social login (Facebook)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Image upload and S3 storage",
          "priority": "must-have"
        }
      ],
      "integrations": [
        "Facebook OAuth",
        "Amazon S3",
        "Sphinx Search Engine",
        "Mercury WYSIWYG Editor",
        "Delayed Job",
        "Stripe or similar payment processors"
      ],
      "scale": "medium",
      "domain": "marketplace",
      "tech_stack": {
        "frontend": "React, jQuery, JavaScript with Webpack",
        "backend": "Ruby on Rails 8.1.2",
        "database": "MySQL 8.4",
        "infrastructure": "Heroku, Amazon S3, Sphinx Search",
        "key_libraries": [
          "devise",
          "omniauth-facebook",
          "haml",
          "paperclip",
          "react_on_rails",
          "mysql2",
          "passenger",
          "thinking_sphinx",
          "delayed_job",
          "rspec-rails",
          "cucumber-rails",
          "factory_bot"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Monolithic Rails application with React frontend integration for dynamic UI components while maintaining server-rendered templates",
        "Full-text search implemented via Sphinx rather than database queries, improving marketplace discovery performance",
        "Asynchronous job processing with delayed_job for background operations like image processing and notifications",
        "Comprehensive test coverage using BDD (Cucumber) and unit testing (RSpec) with factory fixtures and Selenium integration tests"
      ]
    }
  }
