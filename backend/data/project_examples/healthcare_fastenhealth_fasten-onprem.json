        "maroto (PDF generation)"
      ]
    },
    "raw_profile": {
      "project_name": "Fasten OnPrem",
      "problem_statement": "Provides a secure, self-hosted personal health record system that aggregates medical data from multiple healthcare providers while keeping data private and under user control. Solves the fragmentation of medical records across different clinics, hospitals, and insurance providers.",
      "target_users": [
        "Individuals managing personal health records",
        "Families coordinating household medical history",
        "Privacy-conscious users unwilling to use cloud-based health platforms",
        "Users seeking to aggregate data from multiple healthcare providers"
      ],
      "core_features": [
        {
          "feature": "Self-hosted personal/family electronic medical record management",
          "priority": "must-have"
        },
        {
          "feature": "FHIR protocol support for medical data import/export",
          "priority": "must-have"
        },
        {
          "feature": "Multi-provider data aggregation dashboard",
          "priority": "must-have"
        },
        {
          "feature": "Condition-specific user dashboards and diagnostic test tracking",
          "priority": "nice-to-have"
        },
        {
          "feature": "Manual data entry and FHIR Bundle import",
          "priority": "must-have"
        },
        {
          "feature": "Local network device discovery for companion mobile apps",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "FHIR (Fast Healthcare Interoperability Resources) protocol",
        "Fasten Sources for healthcare provider integration",
        "GitHub API for releases and updates"
      ],
      "scale": "small",
      "domain": "Healthcare / Personal Health Records",
      "tech_stack": {
        "frontend": "TypeScript with HTML/CSS",
        "backend": "Go with Gin web framework",
        "database": "SQLite with GORM ORM",
        "infrastructure": "Docker/Docker Compose for self-hosted deployment",
        "key_libraries": [
          "gin-gonic/gin",
          "gorm.io/gorm",
          "gorm.io/driver/sqlite",
          "fastenhealth/gofhir-models",
          "fastenhealth/fasten-sources",
          "lestrrat-go/jwx/v2",
          "golang-jwt/jwt/v4",
          "maroto (PDF generation)"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Privacy-first design with self-hosted architecture as core requirement\u2014no external data transmission",
        "Built on widely-adopted FHIR standard for healthcare interoperability to enable flexible data import from various sources",
        "Go backend paired with TypeScript frontend suggests performance focus for medical data handling with modern UX",
        "SQLite database choice indicates MVP/small-scale positioning, avoiding complexity of distributed databases for personal health records"
      ]
    }
  }
