  "metadata": {
    "github_url": "https://github.com/Leantime/leantime",
    "stars": 9884,
    "domain": "productivity",
    "primary_language": "PHP",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "JavaScript, CSS, Blade templates, Twig \u2014 with TipTap rich text editor, FullCalendar, Chart.js, and Lottie animations",
      "backend": "PHP 8.x (Laravel-influenced MVC monolith)",
      "database": "MySQL/MariaDB (SQL)",
      "infrastructure": "Docker, self-hosted; S3-compatible file storage",
      "key_libraries": [
        "TipTap (rich text editor)",
        "FullCalendar",
        "Chart.js",
        "FontAwesome",
        "Lottie/DotLottie",
        "Sentry (error tracking)",
        "Luxon (date/time)",
        "Popper.js",
        "canvas-confetti",
        "Chosen.js",
        "Croppie"
      ]
    },
    "raw_profile": {
      "project_name": "Leantime",
      "problem_statement": "Leantime is an open-source project management system designed for non-project managers, with particular consideration for people with ADHD, autism, and dyslexia. It combines strategy, planning, and execution in an accessible interface that rivals commercial tools like Jira, Trello, and ClickUp.",
      "target_users": [
        "Non-project managers and general team members",
        "Small to medium-sized teams",
        "Neurodivergent individuals (ADHD, autism, dyslexia)",
        "Organizations seeking a self-hosted open-source PM alternative",
        "Agile/scrum teams"
      ],
      "core_features": [
        {
          "feature": "Task management with kanban, gantt, table, list, and calendar views",
          "priority": "must-have"
        },
        {
          "feature": "Goal and metrics tracking with strategy canvases (Lean Canvas, SWOT, Risk Analysis)",
          "priority": "must-have"
        },
        {
          "feature": "Sprint and milestone management with subtasks and dependencies",
          "priority": "must-have"
        },
        {
          "feature": "Time tracking and timesheet management",
          "priority": "must-have"
        },
        {
          "feature": "Wikis, docs, idea boards, and retrospectives",
          "priority": "must-have"
        },
        {
          "feature": "User roles, permissions, 2FA, LDAP/OIDC authentication",
          "priority": "must-have"
        },
        {
          "feature": "Plugin system and REST API for extensibility",
          "priority": "nice-to-have"
        },
        {
          "feature": "Screen and webcam recording, file storage via S3 or local filesystem",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Slack",
        "Mattermost",
        "Discord",
        "AWS S3",
        "Google Calendar (via FullCalendar)",
        "iCalendar",
        "LDAP",
        "OIDC",
        "Sentry",
        "Crowdin (localization)"
      ],
      "scale": "medium",
      "domain": "productivity",
      "tech_stack": {
        "frontend": "JavaScript, CSS, Blade templates, Twig \u2014 with TipTap rich text editor, FullCalendar, Chart.js, and Lottie animations",
        "backend": "PHP 8.x (Laravel-influenced MVC monolith)",
        "database": "MySQL/MariaDB (SQL)",
        "infrastructure": "Docker, self-hosted; S3-compatible file storage",
        "key_libraries": [
          "TipTap (rich text editor)",
          "FullCalendar",
          "Chart.js",
          "FontAwesome",
          "Lottie/DotLottie",
          "Sentry (error tracking)",
          "Luxon (date/time)",
          "Popper.js",
          "canvas-confetti",
          "Chosen.js",
          "Croppie"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Accessibility and cognitive inclusivity are first-class design constraints, shaping UI simplicity alongside a broad feature set \u2014 balancing Trello-like ease with Jira-level depth.",
        "The project uses a modular plugin architecture combined with a REST API to allow extensibility without fragmenting the core monolith.",
        "Frontend is assembled via a JS/CSS build pipeline (Webpack) layered on top of a server-rendered PHP/Blade backend, rather than a full SPA framework, keeping the stack approachable for contributors.",
        "Self-hostability is a core product differentiator, with Docker support and flexible storage backends (local vs. S3) to serve privacy-conscious teams and organizations."
      ]
    }
  }
}