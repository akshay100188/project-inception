    "raw_profile": {
      "project_name": "PyHealth",
      "problem_statement": "PyHealth simplifies clinical predictive modeling and healthcare AI application development by providing a comprehensive deep learning toolkit with pre-built models, healthcare-specific data processing, and standardized pipelines for both ML researchers and medical practitioners.",
      "target_users": [
        "Machine learning researchers",
        "Medical practitioners",
        "Healthcare AI developers",
        "Clinical data scientists"
      ],
      "core_features": [
        {
          "feature": "Modular 5-stage pipeline for healthcare ML workflows",
          "priority": "must-have"
        },
        {
          "feature": "33+ pre-built deep learning models with production-ready trainer/metrics",
          "priority": "must-have"
        },
        {
          "feature": "Support for 10+ healthcare tasks and clinical datasets (MIMIC, eICU, OMOP)",
          "priority": "must-have"
        },
        {
          "feature": "Medical code and electronic health record (EHR) processing",
          "priority": "must-have"
        },
        {
          "feature": "Fast data processing (~3x faster than pandas) for quick experimentation",
          "priority": "nice-to-have"
        },
        {
          "feature": "Benchmarking and planned paper implementations",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "MIMIC clinical dataset",
        "eICU dataset",
        "OMOP data standard",
        "Hugging Face Transformers",
        "PyTorch ecosystem",
        "RDKit for molecular data"
      ],
      "scale": "medium",
      "domain": "Healthcare & Clinical AI",
      "tech_stack": {
        "frontend": null,
        "backend": "Python 3.12+",
        "database": null,
        "infrastructure": "Docker, PyPI distribution",
        "key_libraries": [
          "PyTorch 2.7.1",
          "Transformers 4.53.2",
          "scikit-learn 1.7.0",
          "Polars 1.35.2",
          "Pandas 2.3.1",
          "Dask 2025.11.0",
          "Pydantic 2.11.7",
          "PyArrow 22.0.0",
          "MNE 1.10.0",
          "NetworkX",
          "einops",
          "linear-attention-transformer"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Healthcare-first design: specialized support for medical codes, EHR standards (MIMIC, eICU, OMOP), and clinical data pipelines rather than generic ML toolkit",
        "Modular pipeline abstraction: 5-stage pipeline design enables researchers and practitioners to customize workflows while maintaining standardization across projects",
        "Performance optimization: deliberate use of Polars, Dask, and PyArrow for 3x faster data processing over pandas, addressing real pain points in clinical dataset preprocessing",
        "Production-ready components: emphasis on trainer/metrics/model maturity and benchmarking against published papers indicates focus on reproducibility and deployment readiness in clinical settings"
      ]
    }
