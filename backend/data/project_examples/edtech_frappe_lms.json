    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Vue 3 with Frappe UI",
      "backend": "Python with Frappe Framework",
      "database": "MariaDB (via Frappe Framework)",
      "infrastructure": "Docker, Frappe Cloud, self-hosted options",
      "key_libraries": [
        "Frappe Framework",
        "Frappe UI",
        "Cypress (testing)",
        "Vue"
      ]
    },
    "raw_profile": {
      "project_name": "Frappe Learning",
      "problem_statement": "Provides an easy-to-use, open-source learning management system for creating and delivering online courses with structured content, live classes, and certification. Designed as a simpler alternative to complex platforms like Moodle.",
      "target_users": [
        "Course creators",
        "Educational institutions",
        "Online learning platforms",
        "Corporate training teams",
        "Independent instructors"
      ],
      "core_features": [
        {
          "feature": "Structured Learning (3-level hierarchy: courses, chapters, lessons)",
          "priority": "must-have"
        },
        {
          "feature": "Live Classes with Zoom integration and batch grouping",
          "priority": "must-have"
        },
        {
          "feature": "Quizzes with multiple question types (single-choice, multiple-choice, open-ended)",
          "priority": "must-have"
        },
        {
          "feature": "Assignments with PDF/document submission",
          "priority": "must-have"
        },
        {
          "feature": "Certificate generation with customizable templates",
          "priority": "must-have"
        },
        {
          "feature": "Learner batching and progress tracking",
          "priority": "must-have"
        },
        {
          "feature": "Role-based access control (instructors, learners, admins)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Zoom (live classes)",
        "Frappe Framework ecosystem",
        "Frappe UI components"
      ],
      "scale": "medium",
      "domain": "EdTech / Learning Management Systems",
      "tech_stack": {
        "frontend": "Vue 3 with Frappe UI",
        "backend": "Python with Frappe Framework",
        "database": "MariaDB (via Frappe Framework)",
        "infrastructure": "Docker, Frappe Cloud, self-hosted options",
        "key_libraries": [
          "Frappe Framework",
          "Frappe UI",
          "Cypress (testing)",
          "Vue"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Built on established Frappe ecosystem, leveraging a mature full-stack framework rather than building from scratch, reducing development complexity",
        "Three-tier course hierarchy (courses \u2192 chapters \u2192 lessons) provides clear content organization and learner context",
        "Integrated Zoom live classes directly within the platform streamlines the learning experience without external tool switching",
        "Managed hosting option (Frappe Cloud) and straightforward self-hosting deployment scripts reduce barriers to production deployment"
      ]
    }
  }
