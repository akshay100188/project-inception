    "raw_profile": {
      "project_name": "MedRAX",
      "problem_statement": "Specialized chest X-ray (CXR) analysis models operate in isolation, limiting their practical utility in clinical settings. MedRAX unifies state-of-the-art CXR analysis tools and multimodal LLMs into a single AI agent capable of addressing complex medical queries without additional training.",
      "target_users": [
        "Clinical radiologists",
        "Medical AI researchers",
        "Healthcare institutions deploying automated CXR interpretation",
        "AI/ML researchers benchmarking medical reasoning agents"
      ],
      "core_features": [
        {
          "feature": "Agentic multi-tool orchestration for CXR analysis using LangChain/LangGraph",
          "priority": "must-have"
        },
        {
          "feature": "Disease classification detecting 18 pathology classes via DenseNet-121 (TorchXRayVision)",
          "priority": "must-have"
        },
        {
          "feature": "Anatomical segmentation using MedSAM and PSPNet",
          "priority": "must-have"
        },
        {
          "feature": "Automated radiology report generation via SwinV2 Transformer",
          "priority": "must-have"
        },
        {
          "feature": "Visual QA and medical reasoning via CheXagent and LLaVA-Med",
          "priority": "must-have"
        },
        {
          "feature": "Phrase grounding and finding localization via Maira-2",
          "priority": "nice-to-have"
        },
        {
          "feature": "Synthetic CXR generation using RoentGen diffusion model",
          "priority": "nice-to-have"
        },
        {
          "feature": "ChestAgentBench evaluation framework with 2,500 complex medical queries",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "OpenAI GPT-4o (backbone LLM with vision)",
        "Anthropic Claude (via langchain-anthropic)",
        "Hugging Face Transformers and model hub",
        "Gradio (web interface)",
        "DICOM processing libraries"
      ],
      "scale": "medium",
      "domain": "healthcare",
      "tech_stack": {
        "frontend": "Gradio",
        "backend": "Python, FastAPI, Uvicorn",
        "database": null,
        "infrastructure": "CUDA/GPU, local or cloud-based model weight storage",
        "key_libraries": [
          "langchain-core",
          "langchain-community",
          "langchain-openai",
          "langgraph",
          "torchxrayvision",
          "transformers",
          "torch",
          "torchvision",
          "diffusers",
          "timm",
          "peft",
          "bitsandbytes",
          "accelerate",
          "opencv-python",
          "pydicom",
          "scikit-image",
          "albumentations"
        ]
      },
      "architecture_pattern": "event-driven",
      "lessons": [
        "Tool-agnostic modular design allows new CXR analysis models to be plugged in or removed without core agent changes, enabling incremental capability expansion.",
        "Using LangGraph for agent orchestration enables dynamic, multi-step reasoning loops where the LLM selects and chains specialized tools at inference time without task-specific fine-tuning.",
        "Supporting 4-bit and 8-bit quantization (via bitsandbytes) for large vision-language models (LLaVA-Med, Maira-2) is critical for practical GPU memory constraints in clinical deployments.",
        "Introducing a dedicated benchmark (ChestAgentBench) alongside the system provides reproducible, structured evaluation across diverse CXR reasoning categories, a pattern increasingly important for agentic medical AI."
      ]
    }
  }
