  "metadata": {
    "github_url": "https://github.com/hapifhir/hapi-fhir",
    "stars": 2330,
    "domain": "healthcare",
    "primary_language": "Java",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": null,
      "backend": "Java",
      "database": null,
      "infrastructure": "Azure Pipelines",
      "key_libraries": [
        "HL7 FHIR libraries",
        "RESTful framework components",
        "XML/JSON serialization libraries"
      ]
    },
    "raw_profile": {
      "project_name": "HAPI FHIR",
      "problem_statement": "Provides a comprehensive Java API for building HL7 FHIR-compliant healthcare clients and servers, enabling interoperability in health information exchange systems.",
      "target_users": [
        "Healthcare software developers",
        "Health IT system integrators",
        "FHIR implementation teams",
        "Electronic health record (EHR) vendors",
        "Healthcare data exchange platforms"
      ],
      "core_features": [
        {
          "feature": "FHIR Client API for consuming FHIR resources",
          "priority": "must-have"
        },
        {
          "feature": "FHIR Server framework for building compliant FHIR servers",
          "priority": "must-have"
        },
        {
          "feature": "FHIR resource parsing and serialization (JSON/XML)",
          "priority": "must-have"
        },
        {
          "feature": "Data validation against FHIR specifications",
          "priority": "must-have"
        },
        {
          "feature": "RESTful FHIR API endpoint generation",
          "priority": "must-have"
        },
        {
          "feature": "Support for multiple FHIR versions (DSTU2, STU3, R4, R5)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "HL7 FHIR standard specifications",
        "Maven Central Repository",
        "Azure Pipelines CI/CD",
        "CodeCov code coverage analysis"
      ],
      "scale": "large",
      "domain": "healthcare",
      "tech_stack": {
        "frontend": null,
        "backend": "Java",
        "database": null,
        "infrastructure": "Azure Pipelines",
        "key_libraries": [
          "HL7 FHIR libraries",
          "RESTful framework components",
          "XML/JSON serialization libraries"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Comprehensive healthcare standards implementation requires multi-version support for FHIR specifications, indicating evolution in domain requirements.",
        "Strong CI/CD and code coverage practices critical for healthcare software; Azure Pipelines and CodeCov integration show emphasis on quality assurance.",
        "Modular library design allows developers to use client, server, or resource components independently without heavy coupling.",
        "Open-source healthcare infrastructure projects benefit from clear documentation, live demonstrations, and commercial support options (Smile CDR)."
      ]
    }
  }
