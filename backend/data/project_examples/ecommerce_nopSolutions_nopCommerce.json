  "metadata": {
    "github_url": "https://github.com/nopSolutions/nopCommerce",
    "stars": 10071,
    "domain": "ecommerce",
    "primary_language": "C#",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "ASP.NET Core MVC with Razor views, HTML, CSS, JavaScript",
      "backend": "ASP.NET Core (.NET 9), C#",
      "database": "MS SQL Server, PostgreSQL, MySQL (multi-database via ORM)",
      "infrastructure": "Docker, Azure, Web Farm support, cross-platform (Windows/Linux/Mac)",
      "key_libraries": [
        "ASP.NET Core MVC",
        "Entity Framework Core",
        "FluentMigrator (TSQL migrations)",
        "ASP.NET Core Identity",
        "Async/await throughout"
      ]
    },
    "raw_profile": {
      "project_name": "nopCommerce",
      "problem_statement": "Businesses need a fully-featured, customizable, and free open-source eCommerce platform to build and run online stores of any size. nopCommerce provides a production-ready shopping cart solution built on ASP.NET Core with support for multiple databases and deployment environments.",
      "target_users": [
        "Online retailers and store owners",
        "eCommerce developers and agencies",
        "Enterprises requiring customizable shopping platforms",
        "Small and medium businesses launching online stores"
      ],
      "core_features": [
        {
          "feature": "Product catalog management with categories, attributes, and variants",
          "priority": "must-have"
        },
        {
          "feature": "Shopping cart and checkout workflow",
          "priority": "must-have"
        },
        {
          "feature": "Admin area for store management and configuration",
          "priority": "must-have"
        },
        {
          "feature": "Multi-store and web farm support",
          "priority": "must-have"
        },
        {
          "feature": "Plugin/extension marketplace for third-party integrations",
          "priority": "must-have"
        },
        {
          "feature": "Multi-factor authentication and security features",
          "priority": "must-have"
        },
        {
          "feature": "REST Web API plugin for headless and mobile integrations",
          "priority": "nice-to-have"
        },
        {
          "feature": "Multi-database support (MS SQL, PostgreSQL, MySQL)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Microsoft Azure",
        "Docker",
        "MS SQL Server",
        "PostgreSQL",
        "MySQL",
        "nopCommerce Marketplace (third-party plugins)",
        "REST Web API"
      ],
      "scale": "large",
      "domain": "ecommerce",
      "tech_stack": {
        "frontend": "ASP.NET Core MVC with Razor views, HTML, CSS, JavaScript",
        "backend": "ASP.NET Core (.NET 9), C#",
        "database": "MS SQL Server, PostgreSQL, MySQL (multi-database via ORM)",
        "infrastructure": "Docker, Azure, Web Farm support, cross-platform (Windows/Linux/Mac)",
        "key_libraries": [
          "ASP.NET Core MVC",
          "Entity Framework Core",
          "FluentMigrator (TSQL migrations)",
          "ASP.NET Core Identity",
          "Async/await throughout"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Pluggable architecture with a marketplace-driven plugin system allows extending core functionality without modifying source code, enabling a large ecosystem of third-party integrations.",
        "Full async implementation across all methods improves scalability and throughput for high-traffic eCommerce workloads.",
        "Multi-database abstraction layer supports SQL Server, PostgreSQL, and MySQL, demonstrating the value of repository/ORM patterns for database portability.",
        "Web farm and Azure compatibility is built-in from the ground up, indicating distributed-state management (e.g., distributed cache, shared sessions) was a first-class architectural concern."
      ]
    }
  }
