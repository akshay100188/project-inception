  "metadata": {
    "github_url": "https://github.com/usememos/memos",
    "stars": 59886,
    "domain": "note-taking, knowledge management, social",
    "primary_language": "Go",
    "architecture_pattern": "microservices",
    "tech_stack": {
      "frontend": "React with TypeScript",
      "backend": "Go (Echo framework, gRPC)",
      "database": "SQLite, MySQL, PostgreSQL",
      "infrastructure": "Docker, Kubernetes, Docker Compose",
      "key_libraries": [
        "connect-rpc",
        "grpc-gateway",
        "goldmark (Markdown)",
        "echo (HTTP framework)",
        "aws-sdk-go-v2",
        "openai-go",
        "google/genai",
        "mcp-go"
      ]
    },
    "raw_profile": {
      "project_name": "Memos",
      "problem_statement": "Provides a lightweight, self-hosted note-taking solution for quick capture with total data ownership. Designed as a privacy-focused alternative to cloud-based note-taking apps, eliminating telemetry and vendor lock-in.",
      "target_users": [
        "Privacy-conscious individuals",
        "Self-hosted infrastructure enthusiasts",
        "Knowledge workers needing quick note capture",
        "Teams wanting data sovereignty"
      ],
      "core_features": [
        {
          "feature": "Instant Capture with Timeline-first UI",
          "priority": "must-have"
        },
        {
          "feature": "Markdown-native note editing and storage",
          "priority": "must-have"
        },
        {
          "feature": "Multi-database support (SQLite, MySQL, PostgreSQL)",
          "priority": "must-have"
        },
        {
          "feature": "REST and gRPC APIs for integration",
          "priority": "must-have"
        },
        {
          "feature": "Self-hosted deployment with Docker/Kubernetes",
          "priority": "must-have"
        },
        {
          "feature": "AI integration (OpenAI, Google Gemini)",
          "priority": "nice-to-have"
        },
        {
          "feature": "S3-compatible storage backend",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "OpenAI API",
        "Google Gemini",
        "AWS S3",
        "Docker",
        "Kubernetes",
        "gRPC",
        "OAuth2",
        "Model Context Protocol (MCP)"
      ],
      "scale": "medium",
      "domain": "note-taking, knowledge management, social",
      "tech_stack": {
        "frontend": "React with TypeScript",
        "backend": "Go (Echo framework, gRPC)",
        "database": "SQLite, MySQL, PostgreSQL",
        "infrastructure": "Docker, Kubernetes, Docker Compose",
        "key_libraries": [
          "connect-rpc",
          "grpc-gateway",
          "goldmark (Markdown)",
          "echo (HTTP framework)",
          "aws-sdk-go-v2",
          "openai-go",
          "google/genai",
          "mcp-go"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Lightweight single-binary deployment (20MB Docker image) prioritizes accessibility and reduced operational overhead for self-hosting",
        "Polyglot backend with gRPC and REST APIs enables ecosystem extensibility while maintaining simplicity for basic use cases",
        "Data portability through Markdown storage and zero telemetry reflects privacy-first design principle as core differentiator",
        "AI integration via plugin architecture (OpenAI, Gemini, MCP) allows feature expansion without core bloat"
      ]
    }
  }
