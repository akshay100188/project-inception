  "metadata": {
    "github_url": "https://github.com/wasp-lang/open-saas",
    "stars": 14492,
    "domain": "SaaS",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "React with ShadCN UI and Tailwind CSS",
      "backend": "Node.js",
      "database": "PostgreSQL with Prisma ORM",
      "infrastructure": "Wasp full-stack framework, Railway/Fly.io deployment",
      "key_libraries": [
        "Wasp",
        "Astro",
        "Prisma",
        "TypeScript",
        "Tailwind CSS",
        "Playwright",
        "ESLint",
        "Prettier"
      ]
    },
    "raw_profile": {
      "project_name": "Open SaaS",
      "problem_statement": "Provides a free, open-source, feature-rich SaaS boilerplate that eliminates repetitive setup work for building production-ready SaaS applications with modern JavaScript technologies. Enables rapid SaaS development with built-in authentication, payments, email, and AI integration.",
      "target_users": [
        "SaaS founders and developers",
        "Startup teams",
        "AI-assisted coding tool users",
        "Full-stack JavaScript developers"
      ],
      "core_features": [
        {
          "feature": "Multi-method Authentication (Email, Google, GitHub, Slack, Microsoft)",
          "priority": "must-have"
        },
        {
          "feature": "Payment Integration (Stripe, Polar.sh, Lemon Squeezy)",
          "priority": "must-have"
        },
        {
          "feature": "Email Sending (SendGrid, MailGun, SMTP)",
          "priority": "must-have"
        },
        {
          "feature": "Background Jobs and Cron Tasks",
          "priority": "must-have"
        },
        {
          "feature": "AWS S3 File Upload Support",
          "priority": "nice-to-have"
        },
        {
          "feature": "AI-Ready with Claude Code Plugin and Agent Skills",
          "priority": "nice-to-have"
        },
        {
          "feature": "One-Command Deployment to Railway/Fly.io",
          "priority": "must-have"
        },
        {
          "feature": "ShadCN UI Components and Admin Dashboard",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Stripe",
        "Polar.sh",
        "Lemon Squeezy",
        "SendGrid",
        "MailGun",
        "AWS S3",
        "OpenAI API",
        "Plausible Analytics",
        "Google Analytics",
        "Railway",
        "Fly.io"
      ],
      "scale": "medium",
      "domain": "SaaS",
      "tech_stack": {
        "frontend": "React with ShadCN UI and Tailwind CSS",
        "backend": "Node.js",
        "database": "PostgreSQL with Prisma ORM",
        "infrastructure": "Wasp full-stack framework, Railway/Fly.io deployment",
        "key_libraries": [
          "Wasp",
          "Astro",
          "Prisma",
          "TypeScript",
          "Tailwind CSS",
          "Playwright",
          "ESLint",
          "Prettier"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Full-stack type safety is prioritized through Wasp's end-to-end type inference, eliminating redundant type definitions between frontend and backend",
        "Extensive developer tooling (Prettier, ESLint, TypeScript) is built-in to maintain code quality at scale",
        "AI-assisted development is a first-class citizen with dedicated documentation, plugins, and agent integration patterns",
        "Deployment is abstracted through Wasp CLI to enable one-command deploys across multiple hosting providers"
      ]
    }
  }
