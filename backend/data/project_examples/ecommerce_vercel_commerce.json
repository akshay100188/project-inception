  "metadata": {
    "github_url": "https://github.com/vercel/commerce",
    "stars": 14045,
    "domain": "ecommerce",
    "primary_language": "TypeScript",
    "architecture_pattern": "jamstack",
    "tech_stack": {
      "frontend": "React 19, Next.js 15 (App Router, Server Components)",
      "backend": "Next.js Server Actions, API routes",
      "database": null,
      "infrastructure": "Vercel",
      "key_libraries": [
        "@headlessui/react",
        "@heroicons/react",
        "tailwindcss",
        "sonner",
        "clsx"
      ]
    },
    "raw_profile": {
      "project_name": "Next.js Commerce",
      "problem_statement": "Provides a high-performance, production-ready ecommerce template that demonstrates modern Next.js patterns (App Router, React Server Components, Server Actions) while supporting multiple commerce backends through a pluggable provider architecture.",
      "target_users": [
        "ecommerce merchants",
        "developers building storefronts",
        "Next.js learners",
        "commerce platform providers"
      ],
      "core_features": [
        {
          "feature": "Multi-provider support (Shopify, BigCommerce, Medusa, Saleor, etc.)",
          "priority": "must-have"
        },
        {
          "feature": "Server-rendered product catalog with dynamic revalidation",
          "priority": "must-have"
        },
        {
          "feature": "Shopping cart with Server Actions and useOptimistic updates",
          "priority": "must-have"
        },
        {
          "feature": "Product search with typeahead (via Orama integration)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Visual CMS editing (via React Bricks integration)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Responsive product details and checkout flow",
          "priority": "must-have"
        }
      ],
      "integrations": [
        "Shopify Storefront API",
        "BigCommerce",
        "Medusa",
        "Saleor",
        "Orama (search)",
        "React Bricks (CMS)"
      ],
      "scale": "medium",
      "domain": "ecommerce",
      "tech_stack": {
        "frontend": "React 19, Next.js 15 (App Router, Server Components)",
        "backend": "Next.js Server Actions, API routes",
        "database": null,
        "infrastructure": "Vercel",
        "key_libraries": [
          "@headlessui/react",
          "@heroicons/react",
          "tailwindcss",
          "sonner",
          "clsx"
        ]
      },
      "architecture_pattern": "jamstack",
      "lessons": [
        "Pluggable provider architecture decouples commerce backend from presentation layer, enabling multi-platform support with minimal UI changes",
        "Heavy use of React Server Components and Server Actions for data fetching and mutations reduces client-side complexity and improves performance",
        "Suspense and useOptimistic patterns demonstrate modern Next.js concurrent rendering for optimistic UI updates without request waterfall",
        "Template-first approach with integration examples (Orama, React Bricks) shows extensibility patterns for enterprise feature adoption"
      ]
    }
  }
}