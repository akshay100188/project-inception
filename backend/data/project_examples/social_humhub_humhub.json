  "metadata": {
    "github_url": "https://github.com/humhub/humhub",
    "stars": 6685,
    "domain": "social",
    "primary_language": "PHP",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "JavaScript, SCSS/CSS, Bootstrap (responsive)",
      "backend": "PHP (Yii2 framework)",
      "database": "MySQL/MariaDB (Yii2 ActiveRecord)",
      "infrastructure": "Self-hosted (Apache/Nginx), Grunt-based asset pipeline",
      "key_libraries": [
        "Yii2",
        "Grunt",
        "grunt-contrib-less",
        "grunt-contrib-uglify",
        "grunt-contrib-cssmin",
        "grunt-contrib-concat"
      ]
    },
    "raw_profile": {
      "project_name": "HumHub",
      "problem_statement": "Organizations need an open-source, self-hosted enterprise social network platform to enable internal communication, collaboration, and knowledge sharing. HumHub provides a modular, extensible intranet/social network solution that can be tailored to specific organizational needs.",
      "target_users": [
        "Enterprise organizations",
        "Intranet administrators",
        "Non-profit organizations",
        "Educational institutions",
        "Community managers",
        "Network operators"
      ],
      "core_features": [
        {
          "feature": "User profiles with customizable fields, follow system, and permission management",
          "priority": "must-have"
        },
        {
          "feature": "Spaces (group rooms) for projects, departments, or events with advanced permissions",
          "priority": "must-have"
        },
        {
          "feature": "Content creation and sharing (posts, wiki, photos, videos, events, tasks)",
          "priority": "must-have"
        },
        {
          "feature": "Modular architecture with ~80 installable/activatable modules",
          "priority": "must-have"
        },
        {
          "feature": "Notification system including email summaries",
          "priority": "must-have"
        },
        {
          "feature": "Multi-level commenting and collaboration tools",
          "priority": "must-have"
        },
        {
          "feature": "Search and filtering across content, spaces, and members",
          "priority": "nice-to-have"
        },
        {
          "feature": "Multilingual support (30+ languages)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "LDAP / Advanced LDAP",
        "RESTful API",
        "OnlyOffice",
        "JWT SSO",
        "SMTP/Email"
      ],
      "scale": "large",
      "domain": "social",
      "tech_stack": {
        "frontend": "JavaScript, SCSS/CSS, Bootstrap (responsive)",
        "backend": "PHP (Yii2 framework)",
        "database": "MySQL/MariaDB (Yii2 ActiveRecord)",
        "infrastructure": "Self-hosted (Apache/Nginx), Grunt-based asset pipeline",
        "key_libraries": [
          "Yii2",
          "Grunt",
          "grunt-contrib-less",
          "grunt-contrib-uglify",
          "grunt-contrib-cssmin",
          "grunt-contrib-concat"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Modular monolith design via Yii2's module system allows extensibility without microservices complexity, enabling ~80 optional modules to be installed and activated independently.",
        "Yii2 framework provides a structured MVC pattern with built-in RBAC, making enterprise-grade permission and role management more manageable at scale.",
        "Grunt-based asset pipeline (LESS compilation, JS uglification, CSS minification) reflects a pre-modern frontend toolchain typical of PHP projects that predate Node-centric build systems.",
        "AGPL-3.0 licensing combined with a commercial marketplace for premium modules is a deliberate open-core monetization strategy targeting enterprise customers."
      ]
    }
  }
}