  "metadata": {
    "github_url": "https://github.com/maziyarpanahi/openmed",
    "stars": 1248,
    "domain": "Healthcare / Clinical NLP",
    "primary_language": "Python",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": null,
      "backend": "Python (FastAPI + Uvicorn)",
      "database": null,
      "infrastructure": "Docker, Apple MLX/CoreML (on-device)",
      "key_libraries": [
        "transformers",
        "huggingface-hub",
        "accelerate",
        "tokenizers",
        "fastapi",
        "uvicorn",
        "mlx",
        "coremltools",
        "gliner",
        "torch",
        "safetensors",
        "pysbd",
        "faker"
      ]
    },
    "raw_profile": {
      "project_name": "OpenMed",
      "problem_statement": "Clinical and biomedical text contains rich information that is difficult to extract automatically; OpenMed provides a production-ready medical NLP toolkit for entity extraction, PII de-identification, and medical reasoning without vendor lock-in.",
      "target_users": [
        "Healthcare software developers",
        "Clinical NLP researchers",
        "Healthcare IT teams building HIPAA-compliant systems",
        "Data scientists working with electronic health records",
        "iOS/macOS app developers building on-device medical AI"
      ],
      "core_features": [
        {
          "feature": "Medical Named Entity Recognition (NER) with 12+ curated specialized models",
          "priority": "must-have"
        },
        {
          "feature": "HIPAA-compliant PII detection and de-identification (18 Safe Harbor identifiers)",
          "priority": "must-have"
        },
        {
          "feature": "REST API service via FastAPI for backend integration",
          "priority": "must-have"
        },
        {
          "feature": "Batch processing for multi-document workflows with progress tracking",
          "priority": "must-have"
        },
        {
          "feature": "On-device inference via MLX (Apple Silicon) and CoreML for Swift/iOS/macOS",
          "priority": "nice-to-have"
        },
        {
          "feature": "Configuration profiles (dev/prod/test/fast) and performance profiling tools",
          "priority": "nice-to-have"
        },
        {
          "feature": "Offline/air-gapped deployment from local model directories",
          "priority": "nice-to-have"
        },
        {
          "feature": "Zero-shot NER via GLiNER-family models",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Hugging Face Hub (model hosting and download)",
        "Hugging Face Transformers",
        "MLX (Apple Silicon runtime)",
        "CoreML (Apple on-device inference)",
        "GLiNER (zero-shot NER)",
        "Docker"
      ],
      "scale": "medium",
      "domain": "Healthcare / Clinical NLP",
      "tech_stack": {
        "frontend": null,
        "backend": "Python (FastAPI + Uvicorn)",
        "database": null,
        "infrastructure": "Docker, Apple MLX/CoreML (on-device)",
        "key_libraries": [
          "transformers",
          "huggingface-hub",
          "accelerate",
          "tokenizers",
          "fastapi",
          "uvicorn",
          "mlx",
          "coremltools",
          "gliner",
          "torch",
          "safetensors",
          "pysbd",
          "faker"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Dual-runtime design (Python/HF Transformers + Swift/MLX-CoreML) enables both server-side and fully on-device sovereign AI deployments from a single model registry.",
        "Optional dependency extras (hf, mlx, gliner, coreml, service) allow a lean core install with heavy ML dependencies only pulled in when needed, reducing footprint for constrained environments.",
        "HIPAA compliance is treated as a first-class feature with dedicated PII extraction and de-identification endpoints, signalling that regulatory requirements shaped the API surface.",
        "Support for local/air-gapped model paths alongside Hugging Face Hub lookups reflects a deliberate design for healthcare environments where internet access to external services may be restricted."
      ]
    }
  }
}