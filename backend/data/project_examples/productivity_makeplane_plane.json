  "metadata": {
    "github_url": "https://github.com/makeplane/plane",
    "stars": 49511,
    "domain": "productivity, project-management, issue-tracking",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "React, React Router, TypeScript, Vite, Next.js",
      "backend": "Django, Node.js, Python",
      "database": "PostgreSQL",
      "infrastructure": "Docker, Kubernetes, Redis",
      "key_libraries": [
        "React Router",
        "Django",
        "ProseMirror (rich text editing)",
        "Turbo (monorepo management)",
        "Valibot (validation)",
        "Markdown-it",
        "Husky (git hooks)",
        "Oxlint/Oxfmt (code quality)"
      ]
    },
    "raw_profile": {
      "project_name": "Plane",
      "problem_statement": "Plane is an open-source project management platform that provides a modern alternative to Jira, Linear, Monday, and ClickUp for managing tasks, sprints, documents, and product roadmaps without the overhead of complex tool management.",
      "target_users": [
        "Engineering teams",
        "Product managers",
        "Project managers",
        "Organizations seeking self-hosted project management",
        "Teams requiring issue tracking and sprint planning"
      ],
      "core_features": [
        {
          "feature": "Work Items - Create and manage tasks with rich text editor, file uploads, and issue references",
          "priority": "must-have"
        },
        {
          "feature": "Cycles - Sprint-like functionality with burn-down charts and progress tracking",
          "priority": "must-have"
        },
        {
          "feature": "Modules - Divide complex projects into manageable components",
          "priority": "must-have"
        },
        {
          "feature": "Customizable Views - Create filtered views and save/share them with teams",
          "priority": "must-have"
        },
        {
          "feature": "Pages - Capture ideas with AI capabilities and rich text editor",
          "priority": "nice-to-have"
        },
        {
          "feature": "Analytics - Real-time insights and trend visualization across project data",
          "priority": "nice-to-have"
        },
        {
          "feature": "Kanban/Gantt Board Support - Multiple visualization options for workflows",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Cloud deployment (Plane Cloud)",
        "Docker containerization",
        "Kubernetes orchestration",
        "Instance admin God mode for self-hosted configuration"
      ],
      "scale": "large",
      "domain": "productivity, project-management, issue-tracking",
      "tech_stack": {
        "frontend": "React, React Router, TypeScript, Vite, Next.js",
        "backend": "Django, Node.js, Python",
        "database": "PostgreSQL",
        "infrastructure": "Docker, Kubernetes, Redis",
        "key_libraries": [
          "React Router",
          "Django",
          "ProseMirror (rich text editing)",
          "Turbo (monorepo management)",
          "Valibot (validation)",
          "Markdown-it",
          "Husky (git hooks)",
          "Oxlint/Oxfmt (code quality)"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Monorepo structure using Turbo for managing multiple packages and coordinated builds across frontend and backend",
        "Self-hosted first approach with Docker and Kubernetes support reflects enterprise focus on data privacy and control",
        "Feature-rich rich text editing and AI integration indicates emphasis on knowledge capture alongside task management",
        "Comprehensive analytics and multiple visualization modes (Kanban, Gantt, custom views) suggest design prioritizes workflow flexibility and team autonomy"
      ]
    }
  }
