  "metadata": {
    "github_url": "https://github.com/opf/openproject",
    "stars": 15134,
    "domain": "productivity",
    "primary_language": "Ruby",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Angular (TypeScript)",
      "backend": "Ruby on Rails",
      "database": "PostgreSQL (inferred from Rails conventions)",
      "infrastructure": "Docker, Nix, Shell scripts",
      "key_libraries": [
        "Angular",
        "@xeokit/xeokit-gltf-to-xkt",
        "@redocly/cli",
        "Sass/SCSS"
      ]
    },
    "raw_profile": {
      "project_name": "OpenProject",
      "problem_statement": "Teams and organizations need a comprehensive, open-source web-based platform to manage projects, tasks, and collaboration. OpenProject provides a self-hostable alternative to proprietary project management tools with features spanning agile, planning, and reporting.",
      "target_users": [
        "Software development teams",
        "Project managers",
        "Product managers",
        "Scrum/agile teams",
        "Organizations requiring self-hosted or on-premises project management",
        "Enterprise teams needing compliance and data control"
      ],
      "core_features": [
        {
          "feature": "Work package tracking and task management",
          "priority": "must-have"
        },
        {
          "feature": "Gantt chart / project planning and scheduling",
          "priority": "must-have"
        },
        {
          "feature": "Agile boards (Kanban/Scrum)",
          "priority": "must-have"
        },
        {
          "feature": "Time tracking, cost reporting, and budgeting",
          "priority": "must-have"
        },
        {
          "feature": "Product roadmap and release planning",
          "priority": "must-have"
        },
        {
          "feature": "Bug and issue tracking",
          "priority": "must-have"
        },
        {
          "feature": "Wiki, forums, and meeting management",
          "priority": "nice-to-have"
        },
        {
          "feature": "BIM/IFC and BCF integration for construction projects",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "GitHub (pull request linking)",
        "xeokit (IFC/BIM 3D model viewing)",
        "Redocly (OpenAPI documentation)"
      ],
      "scale": "large",
      "domain": "productivity",
      "tech_stack": {
        "frontend": "Angular (TypeScript)",
        "backend": "Ruby on Rails",
        "database": "PostgreSQL (inferred from Rails conventions)",
        "infrastructure": "Docker, Nix, Shell scripts",
        "key_libraries": [
          "Angular",
          "@xeokit/xeokit-gltf-to-xkt",
          "@redocly/cli",
          "Sass/SCSS"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Hybrid rendering architecture: Rails handles server-side logic and API while Angular powers rich interactive frontend modules, a pragmatic approach for incrementally modernizing a large Rails app.",
        "BIM/IFC support via xeokit indicates domain-specific extensibility built into the core product, targeting construction and engineering verticals beyond typical project management tools.",
        "Multi-edition strategy (Community, Enterprise cloud, Enterprise on-premises) is reflected in the codebase structure, requiring clean separation of open-source core from proprietary add-ons.",
        "Extensive use of Ruby with a TypeScript frontend suggests a long-lived codebase gradually adopting modern frontend tooling without a full rewrite."
      ]
    }
  }
}