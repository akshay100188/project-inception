  "metadata": {
    "github_url": "https://github.com/getlago/lago",
    "stars": 9708,
    "domain": "fintech / billing infrastructure",
    "primary_language": "Go",
    "architecture_pattern": "microservices",
    "tech_stack": {
      "frontend": "React",
      "backend": "Go, Ruby",
      "database": "ClickHouse (for analytics/events)",
      "infrastructure": "Docker, Docker Compose",
      "key_libraries": [
        "ClickHouse (event ingestion and aggregation)",
        "OpenAPI (API specification)",
        "RSA encryption (for key management)"
      ]
    },
    "raw_profile": {
      "project_name": "Lago",
      "problem_statement": "Lago is an open-source metering and usage-based billing platform that enables product-led companies to track consumption, manage subscriptions, and automate revenue collection. It solves the complexity of implementing flexible pricing models (usage-based, subscription, hybrid) with integrated payment orchestration and revenue analytics.",
      "target_users": [
        "Product-led SaaS companies",
        "Platform and marketplace operators",
        "Fintech companies",
        "Enterprise billing teams",
        "Companies with usage-based or hybrid pricing models"
      ],
      "core_features": [
        {
          "feature": "Usage Metering - Real-time event ingestion and aggregation",
          "priority": "must-have"
        },
        {
          "feature": "Billing & Invoicing - Automated invoice generation",
          "priority": "must-have"
        },
        {
          "feature": "Payment Orchestration - Multi-gateway support with dunning and retries",
          "priority": "must-have"
        },
        {
          "feature": "Revenue Analytics - MRR visibility and usage trends",
          "priority": "must-have"
        },
        {
          "feature": "Entitlements - Feature access management tied to billing plans",
          "priority": "nice-to-have"
        },
        {
          "feature": "Lago Embedded - White-label billing for platforms",
          "priority": "nice-to-have"
        },
        {
          "feature": "AI-powered billing intelligence and MCP server",
          "priority": "nice-to-have"
        },
        {
          "feature": "Enterprise integrations - NetSuite, Xero, Salesforce, Avalara",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Stripe",
        "Adyen",
        "GoCardless",
        "NetSuite",
        "Xero",
        "Salesforce",
        "HubSpot",
        "Avalara",
        "AWS Marketplace",
        "Azure Marketplace",
        "GCP Marketplace"
      ],
      "scale": "large",
      "domain": "fintech / billing infrastructure",
      "tech_stack": {
        "frontend": "React",
        "backend": "Go, Ruby",
        "database": "ClickHouse (for analytics/events)",
        "infrastructure": "Docker, Docker Compose",
        "key_libraries": [
          "ClickHouse (event ingestion and aggregation)",
          "OpenAPI (API specification)",
          "RSA encryption (for key management)"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Event-driven architecture with ClickHouse for high-volume consumption event ingestion and aggregation, enabling real-time metering at scale",
        "API-first design philosophy with comprehensive REST API coverage and multi-language SDK support (Node.js, Python, Ruby, Go) for developer accessibility",
        "Self-hosted and SaaS deployment flexibility via Docker Compose with careful consideration for configuration (S3/GCS storage, SMTP, SSL, dedicated workers) to support both small and enterprise deployments",
        "Polyglot backend approach using both Go and Ruby, likely optimizing for Go's performance in high-throughput event processing and Ruby for business logic and admin operations"
      ]
    }
  }
