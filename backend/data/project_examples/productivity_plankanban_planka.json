  "metadata": {
    "github_url": "https://github.com/plankanban/planka",
    "stars": 12002,
    "domain": "productivity",
    "primary_language": "JavaScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "React (JavaScript/JSX, SCSS)",
      "backend": "Node.js (Sails.js framework)",
      "database": "PostgreSQL",
      "infrastructure": "Docker, self-hosted",
      "key_libraries": [
        "concurrently",
        "husky",
        "lint-staged",
        "genversion"
      ]
    },
    "raw_profile": {
      "project_name": "PLANKA",
      "problem_statement": "Teams need a self-hosted, open-source Kanban board tool for collaborative project management without relying on proprietary SaaS solutions. PLANKA provides a Trello-like experience that can be deployed on your own infrastructure.",
      "target_users": [
        "Software development teams",
        "Project managers",
        "Agile practitioners",
        "Organizations requiring self-hosted project management tools",
        "Small to medium businesses seeking Trello alternatives"
      ],
      "core_features": [
        {
          "feature": "Collaborative Kanban boards with drag-and-drop interface (projects, boards, lists, cards)",
          "priority": "must-have"
        },
        {
          "feature": "Real-time updates and syncing across all connected users",
          "priority": "must-have"
        },
        {
          "feature": "Rich markdown editor for card descriptions",
          "priority": "must-have"
        },
        {
          "feature": "Flexible notifications via 100+ providers",
          "priority": "nice-to-have"
        },
        {
          "feature": "Single sign-on via OpenID Connect (OIDC) integration",
          "priority": "must-have"
        },
        {
          "feature": "Internationalization and multilingual support",
          "priority": "nice-to-have"
        },
        {
          "feature": "REST API with Swagger documentation",
          "priority": "must-have"
        },
        {
          "feature": "Self-hosted Docker deployment",
          "priority": "must-have"
        }
      ],
      "integrations": [
        "OpenID Connect (SSO)",
        "Docker",
        "Discord (community)",
        "100+ notification providers",
        "TestFlight (iOS Notes app)"
      ],
      "scale": "medium",
      "domain": "productivity",
      "tech_stack": {
        "frontend": "React (JavaScript/JSX, SCSS)",
        "backend": "Node.js (Sails.js framework)",
        "database": "PostgreSQL",
        "infrastructure": "Docker, self-hosted",
        "key_libraries": [
          "concurrently",
          "husky",
          "lint-staged",
          "genversion"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Monorepo structure with separate client and server workspaces managed via npm prefix scripts, enabling independent builds and linting while sharing a single repository.",
        "Real-time collaboration is a first-class concern, likely implemented via WebSockets to push board state changes to all connected clients without polling.",
        "Self-hostability is a core design principle, with Docker as the primary deployment target and environment-based configuration for flexibility across environments.",
        "Fair-code licensing model (source-available with commercial restrictions) combined with a hosted Pro/Enterprise tier represents a sustainable open-core business strategy."
      ]
    }
  }
}