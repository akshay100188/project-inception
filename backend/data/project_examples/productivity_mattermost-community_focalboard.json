  "metadata": {
    "github_url": "https://github.com/mattermost-community/focalboard",
    "stars": 26169,
    "domain": "Project Management / Productivity",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "TypeScript, React, SCSS",
      "backend": "Go",
      "database": "SQLite (desktop), configurable for server",
      "infrastructure": "Docker, Electron (desktop), WPF (.NET for Windows), macOS native, GTK (Linux)",
      "key_libraries": [
        "React",
        "TypeScript",
        "Go standard library",
        "Electron",
        "Docker"
      ]
    },
    "raw_profile": {
      "project_name": "Focalboard",
      "problem_statement": "Provides an open-source, self-hosted alternative to commercial project management tools like Trello, Notion, and Asana. Enables teams and individuals to define, organize, track, and manage work without vendor lock-in.",
      "target_users": [
        "Individual users (personal desktop app)",
        "Small to medium teams",
        "Organizations seeking self-hosted solutions",
        "Developers and technical teams"
      ],
      "core_features": [
        {
          "feature": "Kanban boards with cards and columns",
          "priority": "must-have"
        },
        {
          "feature": "Multi-user collaboration and sharing",
          "priority": "must-have"
        },
        {
          "feature": "Task management and tracking",
          "priority": "must-have"
        },
        {
          "feature": "Cross-platform desktop apps (Windows, macOS, Linux)",
          "priority": "must-have"
        },
        {
          "feature": "Personal server deployment for teams",
          "priority": "must-have"
        },
        {
          "feature": "REST API for integrations",
          "priority": "nice-to-have"
        },
        {
          "feature": "Multilingual support",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Mattermost (plugin version available)",
        "Docker containerization",
        "REST API endpoints for custom integrations"
      ],
      "scale": "medium",
      "domain": "Project Management / Productivity",
      "tech_stack": {
        "frontend": "TypeScript, React, SCSS",
        "backend": "Go",
        "database": "SQLite (desktop), configurable for server",
        "infrastructure": "Docker, Electron (desktop), WPF (.NET for Windows), macOS native, GTK (Linux)",
        "key_libraries": [
          "React",
          "TypeScript",
          "Go standard library",
          "Electron",
          "Docker"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Full-stack TypeScript/Go architecture enables code sharing and consistent tooling across frontend and backend",
        "Multi-platform desktop distribution strategy (App Stores + direct downloads + Docker) maximizes accessibility",
        "Modular build system (make-based) supports selective compilation for different targets (web, desktop variants)",
        "Self-hosted emphasis with SQLite default reduces infrastructure requirements and privacy concerns compared to SaaS alternatives"
      ]
    }
  }
