  "metadata": {
    "github_url": "https://github.com/kriasoft/react-starter-kit",
    "stars": 23591,
    "domain": "SaaS",
    "primary_language": "TypeScript",
    "architecture_pattern": "serverless",
    "tech_stack": {
      "frontend": "React 19, TanStack Router, TanStack Query, Jotai, Tailwind CSS v4, shadcn/ui, Vite",
      "backend": "Hono, tRPC, Better Auth, Cloudflare Workers",
      "database": "Drizzle ORM, Neon PostgreSQL",
      "infrastructure": "Cloudflare Workers, Terraform, Docker",
      "key_libraries": [
        "react@19",
        "trpc",
        "drizzle-orm",
        "better-auth",
        "hono",
        "tanstack-router",
        "tanstack-query",
        "jotai",
        "stripe",
        "tailwindcss@4",
        "shadcn-ui",
        "astro",
        "react-email",
        "vite",
        "vitest"
      ]
    },
    "raw_profile": {
      "project_name": "React Starter Kit",
      "problem_statement": "Provides a production-ready, type-safe full-stack monorepo template for building SaaS applications with modern React and edge computing. Eliminates boilerplate setup by bundling authentication, billing, database, and deployment infrastructure into a cohesive starter kit.",
      "target_users": [
        "SaaS founders and product teams",
        "Full-stack JavaScript developers",
        "Teams prioritizing type safety and developer experience",
        "Projects targeting edge deployment"
      ],
      "core_features": [
        {
          "feature": "Type-safe full-stack development with TypeScript, tRPC, and Drizzle ORM",
          "priority": "must-have"
        },
        {
          "feature": "Built-in authentication with Better Auth (email OTP, passkeys, OAuth, organizations)",
          "priority": "must-have"
        },
        {
          "feature": "Stripe subscription billing integration",
          "priority": "must-have"
        },
        {
          "feature": "Edge-native deployment to Cloudflare Workers with service bindings",
          "priority": "must-have"
        },
        {
          "feature": "Modern React 19 frontend with TanStack Router, Query, and Tailwind CSS v4",
          "priority": "must-have"
        },
        {
          "feature": "PostgreSQL database with Drizzle ORM, migrations, and seed data",
          "priority": "must-have"
        },
        {
          "feature": "Astro marketing site and React Email templates",
          "priority": "nice-to-have"
        },
        {
          "feature": "Comprehensive documentation with VitePress and AI assistants",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Stripe (payment processing and subscriptions)",
        "Better Auth (authentication provider)",
        "Cloudflare Workers (serverless runtime and deployment)",
        "Neon PostgreSQL (managed database)",
        "Google OAuth",
        "Cloudflare Hyperdrive (database acceleration)"
      ],
      "scale": "medium",
      "domain": "SaaS",
      "tech_stack": {
        "frontend": "React 19, TanStack Router, TanStack Query, Jotai, Tailwind CSS v4, shadcn/ui, Vite",
        "backend": "Hono, tRPC, Better Auth, Cloudflare Workers",
        "database": "Drizzle ORM, Neon PostgreSQL",
        "infrastructure": "Cloudflare Workers, Terraform, Docker",
        "key_libraries": [
          "react@19",
          "trpc",
          "drizzle-orm",
          "better-auth",
          "hono",
          "tanstack-router",
          "tanstack-query",
          "jotai",
          "stripe",
          "tailwindcss@4",
          "shadcn-ui",
          "astro",
          "react-email",
          "vite",
          "vitest"
        ]
      },
      "architecture_pattern": "serverless",
      "lessons": [
        "Monorepo with independent deployment per app (web, app, api) to Cloudflare Workers using service bindings for inter-app communication",
        "Type safety prioritized across all layers\u2014TypeScript, tRPC, and Drizzle create a single type contract from database schema to UI components",
        "Developer experience optimized with Bun runtime, Vite/Vitest, pre-configured VSCode settings, AI-powered documentation assistants, and edge-native workflows",
        "Production-ready templates include auth with multiple strategies (OTP, passkeys, OAuth), billing integration, database migrations, seed data, and infrastructure-as-code (Terraform)"
      ]
    }
  }
