      ]
    },
    "raw_profile": {
      "project_name": "Sensei LMS",
      "problem_statement": "Sensei LMS provides educators and knowledge-sharers with a robust, open-source Learning Management System built natively for WordPress, enabling them to create, manage, and deliver online courses, quizzes, and learning experiences without leaving the WordPress ecosystem.",
      "target_users": [
        "Educators and online course creators",
        "WordPress site owners",
        "E-learning developers and integrators",
        "Training organizations and schools"
      ],
      "core_features": [
        {
          "feature": "Course creation and management with WordPress block editor support",
          "priority": "must-have"
        },
        {
          "feature": "Quiz and assessment engine",
          "priority": "must-have"
        },
        {
          "feature": "Student enrollment and progress tracking",
          "priority": "must-have"
        },
        {
          "feature": "Analytics and reporting on student and course performance",
          "priority": "must-have"
        },
        {
          "feature": "Learning Mode \u2014 distraction-free, customizable lesson view",
          "priority": "must-have"
        },
        {
          "feature": "Guest/preview access for unregistered users and teacher preview-as-student",
          "priority": "nice-to-have"
        },
        {
          "feature": "MailPoet integration for email communications",
          "priority": "nice-to-have"
        },
        {
          "feature": "WooCommerce integration for selling courses (Sensei Pro)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "WordPress",
        "WooCommerce",
        "MailPoet",
        "VideoPress",
        "WordPress.com managed hosting"
      ],
      "scale": "large",
      "domain": "edtech",
      "tech_stack": {
        "frontend": "React 18, WordPress Block Editor (Gutenberg), SCSS",
        "backend": "PHP (WordPress plugin)",
        "database": "MySQL (via WordPress)",
        "infrastructure": "WordPress.com / self-hosted WordPress",
        "key_libraries": [
          "@wordpress/block-editor",
          "@wordpress/components",
          "@wordpress/data",
          "@automattic/tour-kit",
          "@automattic/components",
          "lodash",
          "classnames",
          "react",
          "qrcode.react",
          "@playwright/test"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Built as a WordPress plugin monolith, leveraging WordPress hooks and filters extensively to allow third-party extensibility without modifying core code.",
        "Frontend is modularized using the Gutenberg block editor paradigm with @wordpress/* packages, enabling a component-driven UI while staying within the WordPress ecosystem.",
        "Freemium architecture separates core open-source features (Sensei LMS) from premium capabilities (Sensei Pro), encouraging community adoption while monetizing advanced features.",
        "Playwright is used for end-to-end testing alongside a PHP unit test suite, indicating a mature QA strategy across both frontend and backend layers."
      ]
    }
  }
