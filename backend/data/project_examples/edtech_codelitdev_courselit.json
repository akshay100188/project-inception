  "metadata": {
    "github_url": "https://github.com/codelitdev/courselit",
    "stars": 1161,
    "domain": "EdTech / E-Learning",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "React, TypeScript, CSS",
      "backend": "Node.js, TypeScript",
      "database": "MongoDB",
      "infrastructure": "Vercel, Docker, pnpm workspaces",
      "key_libraries": [
        "Next.js (implied from Vercel deployment)",
        "Jest (testing)",
        "ESLint, Prettier (linting/formatting)",
        "Astro (documentation/static content)",
        "MDX (content authoring)"
      ]
    },
    "raw_profile": {
      "project_name": "CourseLit",
      "problem_statement": "An open-source learning management system that enables creators to sell online courses, digital downloads, and publish blogs on their own branded websites. Provides a self-hosted alternative to proprietary platforms like Teachable, Thinkific, and Podia.",
      "target_users": [
        "Online course creators",
        "Digital product sellers",
        "Educational content publishers",
        "Small to medium educational businesses",
        "Self-hosted platform operators"
      ],
      "core_features": [
        {
          "feature": "Course authoring and management",
          "priority": "must-have"
        },
        {
          "feature": "Student management and enrollment",
          "priority": "must-have"
        },
        {
          "feature": "Payment processing via Stripe",
          "priority": "must-have"
        },
        {
          "feature": "Website builder with custom sales pages",
          "priority": "must-have"
        },
        {
          "feature": "Blog publishing and CMS",
          "priority": "nice-to-have"
        },
        {
          "feature": "Analytics dashboard",
          "priority": "nice-to-have"
        },
        {
          "feature": "Custom widget extensibility",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Stripe (payment processing)",
        "MediaLit (media asset management)",
        "Vercel (deployment)",
        "MongoDB (database)"
      ],
      "scale": "medium",
      "domain": "EdTech / E-Learning",
      "tech_stack": {
        "frontend": "React, TypeScript, CSS",
        "backend": "Node.js, TypeScript",
        "database": "MongoDB",
        "infrastructure": "Vercel, Docker, pnpm workspaces",
        "key_libraries": [
          "Next.js (implied from Vercel deployment)",
          "Jest (testing)",
          "ESLint, Prettier (linting/formatting)",
          "Astro (documentation/static content)",
          "MDX (content authoring)"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Monorepo structure with pnpm workspaces enables code sharing across packages and apps (web, docs) while maintaining separation of concerns",
        "Batteries-included philosophy: pre-packages essential features (payments, media, analytics) rather than relying on plugins, reducing complexity for end-users",
        "Custom widget system allows extensibility without forking the core codebase, supporting community-driven feature expansion",
        "Self-hosting support with documented migration scripts and environment configuration demonstrates commitment to platform independence and data sovereignty"
      ]
    }
  }
}