      ]
    },
    "raw_profile": {
      "project_name": "Tutor",
      "problem_statement": "Deploying, customizing, upgrading, and scaling Open edX platforms is complex and error-prone. Tutor provides a Docker-based distribution that simplifies the entire lifecycle of Open edX installations for both production and local development.",
      "target_users": [
        "EdTech platform administrators",
        "DevOps engineers managing Open edX",
        "Developers building on Open edX",
        "Educational institutions deploying Open edX",
        "Non-technical users via zero-click AWS installation"
      ],
      "core_features": [
        {
          "feature": "One-click installation and upgrades of Open edX via CLI",
          "priority": "must-have"
        },
        {
          "feature": "Docker-based containerized deployment for local and production environments",
          "priority": "must-have"
        },
        {
          "feature": "Kubernetes support for scalable deployments",
          "priority": "must-have"
        },
        {
          "feature": "Plugin/extensible architecture for customization",
          "priority": "must-have"
        },
        {
          "feature": "Built-in HTTPS/SSL certificate management",
          "priority": "must-have"
        },
        {
          "feature": "Zero-click AWS image deployment",
          "priority": "nice-to-have"
        },
        {
          "feature": "Custom theming and translations support",
          "priority": "nice-to-have"
        },
        {
          "feature": "SCORM xBlock and mobile app integration",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Docker",
        "Docker Compose",
        "Kubernetes",
        "AWS",
        "Open edX (edx-platform)",
        "PyPI",
        "Let's Encrypt (HTTPS)"
      ],
      "scale": "large",
      "domain": "edtech",
      "tech_stack": {
        "frontend": null,
        "backend": "Python (CLI tooling)",
        "database": null,
        "infrastructure": "Docker, Docker Compose, Kubernetes",
        "key_libraries": [
          "Click (CLI framework)",
          "Jinja2 (templating)",
          "Hatchling (build system)"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "CLI-first design pattern using Python Click enables both scripted automation and interactive use without a web UI layer",
        "Jinja2 templating is used extensively for generating Docker Compose, Kubernetes manifests, and config files, enabling flexible environment-specific customization",
        "Plugin architecture decouples core functionality from optional features, allowing community extensions without modifying the core codebase",
        "Dynamic dependency resolution via custom Hatch build hooks (hatch_build.py) allows the package to conditionally bundle plugin requirements at build time"
      ]
    }
  }
