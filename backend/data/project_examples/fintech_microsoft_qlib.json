      "project_name": "Qlib",
      "problem_statement": "Qlib is an AI-oriented quantitative investment platform that empowers quant researchers to explore trading ideas and implement production systems using machine learning and reinforcement learning. It automates the R&D process from factor discovery to model optimization using LLM-based agents.",
      "target_users": [
        "Quantitative researchers",
        "Algorithmic traders",
        "Investment firms",
        "ML practitioners in fintech"
      ],
      "core_features": [
        {
          "feature": "Multi-paradigm ML modeling (supervised learning, market dynamics, reinforcement learning)",
          "priority": "must-have"
        },
        {
          "feature": "RD-Agent: LLM-based autonomous agents for factor mining and model optimization",
          "priority": "must-have"
        },
        {
          "feature": "Market data infrastructure with Point-in-Time database and multiple data providers",
          "priority": "must-have"
        },
        {
          "feature": "Pre-built deep learning models (HIST, IGMTF, KRNN, Sandwich, TCN, ADARNN, ADD)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Portfolio optimization and backtesting framework",
          "priority": "must-have"
        },
        {
          "feature": "Meta-learning and transfer learning support",
          "priority": "nice-to-have"
        },
        {
          "feature": "High-frequency trading and nested decision execution framework",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "MLflow for model tracking and management",
        "Redis for caching and distributed computing",
        "MongoDB for data persistence",
        "Arctic for data backends",
        "LightGBM for gradient boosting",
        "PyTorch (optional, for deep learning)",
        "Gym for reinforcement learning environments"
      ],
      "scale": "large",
      "domain": "fintech",
