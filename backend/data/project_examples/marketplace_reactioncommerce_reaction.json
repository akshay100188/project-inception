        "Docker Compose"
      ]
    },
    "raw_profile": {
      "project_name": "Mailchimp Open Commerce (formerly Reaction Commerce)",
      "problem_statement": "Provides an API-first, headless e-commerce platform that allows retailers to build flexible, scalable online stores without being locked into monolithic solutions. Enables businesses to manage products, inventory, orders, and multi-tenant shops with high performance and composable integrations.",
      "target_users": [
        "E-commerce businesses",
        "Marketplace operators",
        "API-first development teams",
        "Enterprise retailers",
        "SaaS platform providers"
      ],
      "core_features": [
        {
          "feature": "Headless GraphQL API",
          "priority": "must-have"
        },
        {
          "feature": "Product management with options and variants",
          "priority": "must-have"
        },
        {
          "feature": "Multi-tenant shop hosting",
          "priority": "must-have"
        },
        {
          "feature": "Inventory and order tracking system",
          "priority": "must-have"
        },
        {
          "feature": "Plugin-based architecture for extensibility",
          "priority": "must-have"
        },
        {
          "feature": "Shipping and tax rate integration",
          "priority": "nice-to-have"
        },
        {
          "feature": "Admin dashboard and order management UI",
          "priority": "nice-to-have"
        },
        {
          "feature": "Customizable email templates",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Mailchimp",
        "Shipping rate providers",
        "Tax rate providers",
        "Custom fulfillment systems",
        "Email service providers"
      ],
      "scale": "large",
      "domain": "e-commerce / marketplace",
      "tech_stack": {
        "frontend": "React",
        "backend": "Node.js",
        "database": "MongoDB",
        "infrastructure": "Docker, Kubernetes",
        "key_libraries": [
          "GraphQL",
          "Express",
          "Babel",
          "ESLint",
          "pnpm",
          "Docker Compose"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Monorepo structure (pnpm workspaces) enables code sharing across API, Admin, and Storefront applications while maintaining independent deployment",
        "Plugin system design allows extensibility without modifying core codebase\u2014custom plugins loaded at runtime for shipping, tax, fulfillment, and integrations",
        "GraphQL-first API design decouples frontend from backend, enabling headless commerce across multiple storefronts and channels",
        "Multi-tenant architecture built into platform core demonstrates enterprise-scale design for hosting multiple shops on shared infrastructure"
      ]
    }
  }
