      "project_name": "Pupilfirst LMS",
      "problem_statement": "Provides an open-source Learning Management System designed for asynchronous online education, where students learn through task-based workflows, expert feedback, iterative improvement, and peer collaboration rather than passive content consumption.",
      "target_users": [
        "Educational institutions",
        "Online schools and academies",
        "Course creators and instructors",
        "Students in asynchronous learning environments"
      ],
      "core_features": [
        {
          "feature": "Task-based learning with iterative feedback loop",
          "priority": "must-have"
        },
        {
          "feature": "Personalized feedback from domain experts",
          "priority": "must-have"
        },
        {
          "feature": "Community interaction and peer learning",
          "priority": "must-have"
        },
        {
          "feature": "Asynchronous course management",
          "priority": "must-have"
        },
        {
          "feature": "Student progress tracking and assessment",
          "priority": "must-have"
        },
        {
          "feature": "Markdown-based content with rich formatting support",
          "priority": "nice-to-have"
        },
        {
          "feature": "Multi-language support (i18n)",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "GraphQL API",
        "Markdown processing (markdown-it with multiple plugins)",
        "Email/notification system (PNotify)",
        "File storage and export (FileSaver, CSV/Papa Parse)",
        "QR code generation"
      ],
      "scale": "medium",
      "domain": "edtech",
      "tech_stack": {
