  "metadata": {
    "github_url": "https://github.com/jeremylongshore/claude-code-plugins-plus-skills",
    "stars": 2232,
    "domain": "marketplace",
    "primary_language": "Python",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Astro (marketplace web UI)",
      "backend": "Python / Node.js (plugin servers, MCP servers, CLI scripts)",
      "database": null,
      "infrastructure": "GitHub Actions, npm registry, pnpm monorepo",
      "key_libraries": [
        "pnpm workspaces",
        "js-yaml",
        "archiver",
        "eslint",
        "prettier",
        "husky",
        "lint-staged",
        "commitlint",
        "TypeScript"
      ]
    },
    "raw_profile": {
      "project_name": "Tons of Skills \u2014 Claude Code Plugins Marketplace",
      "problem_statement": "Developers using Claude Code lack a centralized, curated marketplace to discover and install reusable plugins, skills, and AI agents. This project provides an open-source registry with a CLI package manager (ccpi) to search, install, and manage 425+ plugins and 2,810+ skills for Claude Code.",
      "target_users": [
        "Software developers using Claude Code",
        "DevOps engineers automating workflows with AI",
        "AI/LLM practitioners building agent-based tooling",
        "Plugin and skill contributors to the open-source ecosystem"
      ],
      "core_features": [
        {
          "feature": "CLI package manager (ccpi) for searching, installing, and updating plugins",
          "priority": "must-have"
        },
        {
          "feature": "Curated marketplace of 425+ plugins and 2,810+ skills for Claude Code",
          "priority": "must-have"
        },
        {
          "feature": "Web marketplace UI at tonsofskills.com for browsing and discovery",
          "priority": "must-have"
        },
        {
          "feature": "200 pre-built AI agents ready to deploy",
          "priority": "must-have"
        },
        {
          "feature": "MCP (Model Context Protocol) server support for plugin execution",
          "priority": "must-have"
        },
        {
          "feature": "Downloadable plugin bundle packages (cowork zips)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Automated daily npm download metrics tracking via GitHub Actions",
          "priority": "nice-to-have"
        },
        {
          "feature": "Killer Skill of the Week spotlight with automated README rendering",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Anthropic Claude Code",
        "npm / pnpm registry",
        "GitHub Actions (CI/CD, metrics updates)",
        "Kobiton real-device cloud (mobile testing MCP)",
        "OpenBB Terminal",
        "Skyvern AI",
        "Nixtla (sponsor/integration)",
        "tonsofskills.com (hosted marketplace)"
      ],
      "scale": "medium",
      "domain": "marketplace",
      "tech_stack": {
        "frontend": "Astro (marketplace web UI)",
        "backend": "Python / Node.js (plugin servers, MCP servers, CLI scripts)",
        "database": null,
        "infrastructure": "GitHub Actions, npm registry, pnpm monorepo",
        "key_libraries": [
          "pnpm workspaces",
          "js-yaml",
          "archiver",
          "eslint",
          "prettier",
          "husky",
          "lint-staged",
          "commitlint",
          "TypeScript"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Monorepo structure with pnpm workspaces allows managing 400+ plugin packages and a CLI tool under a single version-controlled repository with shared tooling.",
        "Automated scripts (sync-marketplace, generate-readme-toc, update-metrics) keep the README, marketplace JSON, and download stats consistent without manual intervention, essential at this catalog scale.",
        "MCP (Model Context Protocol) is used as the plugin execution interface, decoupling plugin logic from Claude Code's core and enabling third-party contributors to publish independently via npm.",
        "A companion CLI (ccpi) published to npm mirrors the plugin install experience of traditional package managers, lowering the barrier to adoption for developer-tool audiences."
      ]
    }
  }
}