  "metadata": {
    "github_url": "https://github.com/grandnode/grandnode",
    "stars": 1903,
    "domain": "marketplace",
    "primary_language": "C#",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Vue.js, HTML, CSS, JavaScript",
      "backend": "ASP.NET Core (C#)",
      "database": "MongoDB / AWS DocumentDB / Azure CosmosDB",
      "infrastructure": "Docker",
      "key_libraries": [
        "ASP.NET Core MVC",
        "Vue.js"
      ]
    },
    "raw_profile": {
      "project_name": "GrandNode",
      "problem_statement": "Provides an open-source, headless, multi-tenant eCommerce platform that allows businesses to build and manage online stores with flexible NoSQL storage and cloud-native deployment options.",
      "target_users": [
        "eCommerce developers",
        "online retailers",
        "marketplace operators",
        "system integrators",
        "SMBs and enterprises needing self-hosted storefronts"
      ],
      "core_features": [
        {
          "feature": "Multi-tenant store management",
          "priority": "must-have"
        },
        {
          "feature": "Headless CMS and storefront capabilities",
          "priority": "must-have"
        },
        {
          "feature": "Shopping cart and checkout workflow",
          "priority": "must-have"
        },
        {
          "feature": "Product catalog and inventory management",
          "priority": "must-have"
        },
        {
          "feature": "Marketplace and vendor support",
          "priority": "nice-to-have"
        },
        {
          "feature": "Containerized deployment via Docker",
          "priority": "nice-to-have"
        },
        {
          "feature": "Vue.js-based frontend theming",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "MongoDB",
        "AWS DocumentDB",
        "Azure CosmosDB",
        "Docker"
      ],
      "scale": "large",
      "domain": "marketplace",
      "tech_stack": {
        "frontend": "Vue.js, HTML, CSS, JavaScript",
        "backend": "ASP.NET Core (C#)",
        "database": "MongoDB / AWS DocumentDB / Azure CosmosDB",
        "infrastructure": "Docker",
        "key_libraries": [
          "ASP.NET Core MVC",
          "Vue.js"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Uses a NoSQL document database (MongoDB and cloud equivalents) to achieve schema flexibility and horizontal scalability for product/catalog data.",
        "Headless architecture decouples the storefront from the backend, enabling API-first integrations and custom front-end implementations.",
        "Multi-tenancy is a first-class concern, allowing a single deployment to serve multiple independent stores.",
        "This repository represents a legacy codebase that was superseded by a ground-up rewrite (GrandNode 2.0), highlighting the value of planned architectural migrations over incremental patching."
      ]
    }
  }
