  "metadata": {
    "github_url": "https://github.com/idurar/idurar-erp-crm",
    "stars": 8413,
    "domain": "ecommerce",
    "primary_language": "JavaScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "React.js with Ant Design (AntD) and Redux",
      "backend": "Node.js with Express.js",
      "database": "MongoDB with Mongoose",
      "infrastructure": "Self-hosted / DigitalOcean (cloud.idurarapp.com)",
      "key_libraries": [
        "React",
        "Redux",
        "Ant Design",
        "Express.js",
        "Mongoose",
        "Pug"
      ]
    },
    "raw_profile": {
      "project_name": "IDURAR ERP CRM",
      "problem_statement": "Small to medium businesses need an affordable, self-hostable ERP and CRM solution for managing invoices, quotes, payments, and customer relationships. IDURAR provides a free, open-source alternative to expensive commercial ERP/CRM platforms.",
      "target_users": [
        "small business owners",
        "accountants",
        "sales teams",
        "freelancers",
        "developers seeking a self-hosted ERP/CRM solution"
      ],
      "core_features": [
        {
          "feature": "Invoice Management",
          "priority": "must-have"
        },
        {
          "feature": "Quote/Estimate Management",
          "priority": "must-have"
        },
        {
          "feature": "Payment Management",
          "priority": "must-have"
        },
        {
          "feature": "Customer (CRM) Management",
          "priority": "must-have"
        },
        {
          "feature": "Accounting Module",
          "priority": "must-have"
        },
        {
          "feature": "Inventory Management",
          "priority": "nice-to-have"
        },
        {
          "feature": "HR Management",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "MongoDB Atlas",
        "DigitalOcean"
      ],
      "scale": "medium",
      "domain": "ecommerce",
      "tech_stack": {
        "frontend": "React.js with Ant Design (AntD) and Redux",
        "backend": "Node.js with Express.js",
        "database": "MongoDB with Mongoose",
        "infrastructure": "Self-hosted / DigitalOcean (cloud.idurarapp.com)",
        "key_libraries": [
          "React",
          "Redux",
          "Ant Design",
          "Express.js",
          "Mongoose",
          "Pug"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Uses the MERN stack (MongoDB, Express, React, Node) as a full-stack JavaScript monolith, reducing context-switching and simplifying deployment for self-hosted scenarios.",
        "Adopts Ant Design as the UI component framework, accelerating development of data-dense ERP interfaces like tables, forms, and dashboards.",
        "Redux is used for global state management on the frontend, a common pattern for complex business applications with shared state across many views.",
        "Released under AGPL-3.0 ('Fair-Code') while offering a paid cloud-hosted enterprise version, demonstrating an open-core monetization strategy."
      ]
    }
  }
}