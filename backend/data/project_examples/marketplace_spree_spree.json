  "metadata": {
    "github_url": "https://github.com/spree/spree",
    "stars": 15427,
    "domain": "eCommerce / Marketplace",
    "primary_language": "Ruby",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Next.js 16, React 19, TypeScript, Tailwind CSS 4",
      "backend": "Ruby on Rails",
      "database": "PostgreSQL (inferred from Rails conventions)",
      "infrastructure": "Docker, Render, Turbo monorepo",
      "key_libraries": [
        "Spree gem",
        "TypeScript SDK",
        "Base UI React",
        "Biome (linting)"
      ]
    },
    "raw_profile": {
      "project_name": "Spree Commerce",
      "problem_statement": "Spree is an open-source headless eCommerce platform enabling businesses to launch cross-border storefronts, B2B wholesale marketplaces, and multi-tenant SaaS solutions with a complete REST API and production-ready storefront.",
      "target_users": [
        "B2B wholesale merchants",
        "Multi-vendor marketplace operators",
        "Cross-border eCommerce businesses",
        "SaaS eCommerce providers",
        "Enterprise retailers"
      ],
      "core_features": [
        {
          "feature": "REST API with TypeScript SDK and OpenAPI 3.0 spec",
          "priority": "must-have"
        },
        {
          "feature": "Next.js storefront with multi-region routing and Stripe/Klarna/Affirm payments",
          "priority": "must-have"
        },
        {
          "feature": "Cross-border markets with currency, language, and payment localization",
          "priority": "must-have"
        },
        {
          "feature": "Advanced pricing and promotions engine with price lists and customer groups",
          "priority": "must-have"
        },
        {
          "feature": "Admin dashboard with role-based permissions and Tailwind CSS customization",
          "priority": "must-have"
        },
        {
          "feature": "MeiliSearch integration for typo-tolerant product search and faceted filtering",
          "priority": "nice-to-have"
        },
        {
          "feature": "Event Bus and Webhooks 2.0 for extensibility and integrations",
          "priority": "must-have"
        },
        {
          "feature": "CSV product import/export and bulk operations",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Stripe",
        "Adyen",
        "PayPal",
        "Google Analytics 4",
        "Google Tag Manager",
        "Klaviyo",
        "MeiliSearch"
      ],
      "scale": "large",
      "domain": "eCommerce / Marketplace",
      "tech_stack": {
        "frontend": "Next.js 16, React 19, TypeScript, Tailwind CSS 4",
        "backend": "Ruby on Rails",
        "database": "PostgreSQL (inferred from Rails conventions)",
        "infrastructure": "Docker, Render, Turbo monorepo",
        "key_libraries": [
          "Spree gem",
          "TypeScript SDK",
          "Base UI React",
          "Biome (linting)"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Headless eCommerce design separates API backend (Rails) from frontend consumption, enabling multi-storefront and custom client implementations",
        "Turbo monorepo structure manages multiple interdependent packages (backend, SDK, storefront, admin) with unified tooling and shared development experience",
        "Provider-agnostic payment sessions abstraction allows pluggable payment processors without storefront code changes, reducing coupling",
        "Event Bus and Webhooks 2.0 enable ecosystem extensibility and third-party integrations while maintaining backward compatibility"
      ]
    }
  }
