  "metadata": {
    "github_url": "https://github.com/OpenHealthForAll/open-health",
    "stars": 3896,
    "domain": "healthcare",
    "primary_language": "TypeScript",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "Next.js 15, React 19, TypeScript, Tailwind CSS, Shadcn UI, Framer Motion",
      "backend": "Next.js API routes, Node.js, TypeScript",
      "database": "Prisma ORM",
      "infrastructure": "Docker/Podman, Vercel deployment, Trigger.dev for job execution",
      "key_libraries": [
        "LangChain (multi-LLM framework)",
        "LangSmith (LLM debugging)",
        "Next-Auth 5 (authentication)",
        "Next-intl (internationalization)",
        "React-PDF & pdf2pic (document processing)",
        "Zod (schema validation)",
        "SWR (data fetching)"
      ]
    },
    "raw_profile": {
      "project_name": "OpenHealth",
      "problem_statement": "OpenHealth helps users take charge of their health data by consolidating personal health information and leveraging AI to provide personalized health insights and management assistance. It enables private, locally-runnable health management with data privacy as a core principle.",
      "target_users": [
        "Individual health-conscious users",
        "Patients managing chronic conditions",
        "Users seeking personalized health insights",
        "Privacy-focused health data managers"
      ],
      "core_features": [
        {
          "feature": "Centralized Health Data Input",
          "priority": "must-have"
        },
        {
          "feature": "Smart Data Parsing & Standardization",
          "priority": "must-have"
        },
        {
          "feature": "Contextual AI Conversations",
          "priority": "must-have"
        },
        {
          "feature": "Multi-LLM Support (GPT, Claude, Gemini, LLaMA, DeepSeek, Ollama)",
          "priority": "must-have"
        },
        {
          "feature": "Multi-language Support",
          "priority": "nice-to-have"
        },
        {
          "feature": "Health Data Visualization",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "OpenAI GPT",
        "Anthropic Claude",
        "Google Gemini",
        "Meta LLaMA",
        "DeepSeek-V3",
        "Ollama (local LLM)",
        "Apple Health",
        "Google Fit",
        "Oura Ring",
        "Whoop",
        "Garmin",
        "Vercel Blob Storage",
        "Trigger.dev",
        "Amplitude Analytics"
      ],
      "scale": "medium",
      "domain": "healthcare",
      "tech_stack": {
        "frontend": "Next.js 15, React 19, TypeScript, Tailwind CSS, Shadcn UI, Framer Motion",
        "backend": "Next.js API routes, Node.js, TypeScript",
        "database": "Prisma ORM",
        "infrastructure": "Docker/Podman, Vercel deployment, Trigger.dev for job execution",
        "key_libraries": [
          "LangChain (multi-LLM framework)",
          "LangSmith (LLM debugging)",
          "Next-Auth 5 (authentication)",
          "Next-intl (internationalization)",
          "React-PDF & pdf2pic (document processing)",
          "Zod (schema validation)",
          "SWR (data fetching)"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Privacy-first design: Application supports fully local execution with Ollama and local parsing via Docling, minimizing cloud dependencies",
        "Multi-modal LLM integration: Abstraction layer via LangChain enables flexible switching between commercial and open-source models without vendor lock-in",
        "Polyglot processing: Python-based data parsing (planned TypeScript migration) decoupled from Next.js frontend, showing phased modernization strategy",
        "User-centric internationalization: Early i18n support across 9+ languages indicates global health market ambitions from MVP stage"
      ]
    }
  }
