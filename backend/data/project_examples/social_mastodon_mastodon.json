  "metadata": {
    "github_url": "https://github.com/mastodon/mastodon",
    "stars": 49962,
    "domain": "social network / federated microblogging",
    "primary_language": "Ruby",
    "architecture_pattern": "microservices",
    "tech_stack": {
      "frontend": "React.js with Redux, TypeScript, SCSS, Vite",
      "backend": "Ruby on Rails",
      "database": "PostgreSQL 14+",
      "infrastructure": "Node.js 22+ for streaming API, Redis 7.0+ for caching/queueing, Sidekiq for job processing, Docker, FFmpeg 5.1+ for media processing",
      "key_libraries": [
        "Rails",
        "React",
        "Redux",
        "Vite",
        "Vitest",
        "TypeScript",
        "Sidekiq",
        "@dnd-kit",
        "ESLint",
        "Stylelint"
      ]
    },
    "raw_profile": {
      "project_name": "Mastodon",
      "problem_statement": "Mastodon provides a free, open-source, self-hosted social network server based on ActivityPub that enables users to run their own federated microblogging communities without vendor lock-in, interoperable across the broader Fediverse.",
      "target_users": [
        "Individual users seeking privacy-respecting social media",
        "Server administrators running federated instances",
        "Third-party app developers via REST API",
        "Fediverse participants on non-Mastodon software"
      ],
      "core_features": [
        {
          "feature": "ActivityPub federation - seamless interoperability across federated servers",
          "priority": "must-have"
        },
        {
          "feature": "Real-time chronological timeline with WebSocket streaming",
          "priority": "must-have"
        },
        {
          "feature": "Media attachments - image and video upload and playback",
          "priority": "must-have"
        },
        {
          "feature": "Safety and moderation tools - private posts, blocking, muting, reporting",
          "priority": "must-have"
        },
        {
          "feature": "OAuth2 and REST API for third-party application ecosystem",
          "priority": "must-have"
        },
        {
          "feature": "Multi-language support and internationalization via Crowdin",
          "priority": "nice-to-have"
        },
        {
          "feature": "Docker and docker-compose deployment configurations",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "ActivityPub protocol",
        "WebFinger",
        "OAuth2 providers",
        "BrowserStack for cross-browser testing",
        "Chromatic for visual regression testing"
      ],
      "scale": "large",
      "domain": "social network / federated microblogging",
      "tech_stack": {
        "frontend": "React.js with Redux, TypeScript, SCSS, Vite",
        "backend": "Ruby on Rails",
        "database": "PostgreSQL 14+",
        "infrastructure": "Node.js 22+ for streaming API, Redis 7.0+ for caching/queueing, Sidekiq for job processing, Docker, FFmpeg 5.1+ for media processing",
        "key_libraries": [
          "Rails",
          "React",
          "Redux",
          "Vite",
          "Vitest",
          "TypeScript",
          "Sidekiq",
          "@dnd-kit",
          "ESLint",
          "Stylelint"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Decoupled frontend (React/Vite) from backend (Rails) with separate workspace tooling enables independent scaling of API and UI concerns",
        "Real-time capabilities delegated to Node.js streaming server rather than Rails, following polyglot architecture for performance",
        "Federation via ActivityPub standard allows interoperability without centralization, demonstrating protocol-driven architecture over proprietary APIs",
        "Comprehensive testing strategy combining unit tests, visual regression (Chromatic), cross-browser testing, and linting ensures quality for a critical social infrastructure project"
      ]
    }
  }
