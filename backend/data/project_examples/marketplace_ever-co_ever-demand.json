  "metadata": {
    "github_url": "https://github.com/ever-co/ever-demand",
    "stars": 1839,
    "domain": "marketplace",
    "primary_language": "TypeScript",
    "architecture_pattern": "microservices",
    "tech_stack": {
      "frontend": "Angular 9 (Admin & Shopping Website), Ionic 5 (Mobile Apps), React Native/Expo (WIP), Flutter/Dart (WIP)",
      "backend": "Node.js with NestJS (TypeScript)",
      "database": "MongoDB (inferred from NestJS/reactive stack)",
      "infrastructure": "Docker, Kubernetes, Lerna monorepo",
      "key_libraries": [
        "NestJS",
        "RxJS",
        "InversifyJS",
        "Ionic",
        "Angular",
        "Socket.io",
        "GraphQL",
        "React Native",
        "Expo",
        "Lerna"
      ]
    },
    "raw_profile": {
      "project_name": "Ever\u00ae Demand\u2122",
      "problem_statement": "Provides an open-source, real-time commerce platform for on-demand, collaborative, and sharing economies supporting single and multi-vendor marketplaces. It enables businesses to manage ordering, delivery logistics, inventory, and storefronts through a headless commerce framework.",
      "target_users": [
        "Marketplace operators and platform owners",
        "Merchants and store vendors",
        "Delivery carriers and drivers",
        "End customers placing on-demand orders",
        "Platform administrators"
      ],
      "core_features": [
        {
          "feature": "Multi-store / multi-vendor marketplace support",
          "priority": "must-have"
        },
        {
          "feature": "Real-time order management and processing",
          "priority": "must-have"
        },
        {
          "feature": "Headless commerce APIs (GraphQL, REST, WebSocket)",
          "priority": "must-have"
        },
        {
          "feature": "Mobile apps for customers, carriers, and merchants (Ionic/React Native/Flutter)",
          "priority": "must-have"
        },
        {
          "feature": "Delivery and shipping management with real-time location tracking",
          "priority": "must-have"
        },
        {
          "feature": "Payment gateway integration (Stripe)",
          "priority": "must-have"
        },
        {
          "feature": "Inventory and stock management",
          "priority": "must-have"
        },
        {
          "feature": "Multi-language and internationalization (i18N) support",
          "priority": "nice-to-have"
        }
      ],
      "integrations": [
        "Stripe (payment gateway)",
        "Socket.io (WebSocket real-time communication)",
        "Expo (React Native mobile)",
        "Flutter/Dart (mobile)"
      ],
      "scale": "large",
      "domain": "marketplace",
      "tech_stack": {
        "frontend": "Angular 9 (Admin & Shopping Website), Ionic 5 (Mobile Apps), React Native/Expo (WIP), Flutter/Dart (WIP)",
        "backend": "Node.js with NestJS (TypeScript)",
        "database": "MongoDB (inferred from NestJS/reactive stack)",
        "infrastructure": "Docker, Kubernetes, Lerna monorepo",
        "key_libraries": [
          "NestJS",
          "RxJS",
          "InversifyJS",
          "Ionic",
          "Angular",
          "Socket.io",
          "GraphQL",
          "React Native",
          "Expo",
          "Lerna"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Monorepo managed with Lerna and Yarn workspaces separates concerns across multiple packages (core API, admin, merchant, shop, carrier) while sharing common libraries.",
        "Headless commerce design exposes GraphQL, REST, and WebSocket APIs, decoupling backend logic from multiple frontend implementations across web and mobile.",
        "Heavy use of RxJS and reactive patterns throughout the platform ensures real-time data propagation for orders, inventory, and delivery tracking.",
        "InversifyJS is used for IoC/DI on the frontend while NestJS handles DI on the backend, maintaining consistent inversion-of-control patterns across the full stack."
      ]
    }
  }
}