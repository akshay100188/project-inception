      "project_name": "Medusa",
      "problem_statement": "Medusa is a flexible, open-source commerce platform that provides building blocks and a customizable framework for building advanced digital commerce applications without reinventing core commerce logic.",
      "target_users": [
        "E-commerce developers",
        "Commerce platform builders",
        "B2B and DTC store operators",
        "Marketplace creators",
        "PoS system developers",
        "Service business platforms"
      ],
      "core_features": [
        {
          "feature": "Modular commerce framework with customizable core logic",
          "priority": "must-have"
        },
        {
          "feature": "Open-source commerce modules available on npm",
          "priority": "must-have"
        },
        {
          "feature": "Multi-tenant and advanced B2B capabilities",
          "priority": "must-have"
        },
        {
          "feature": "Managed cloud deployment and scaling (Medusa Cloud)",
          "priority": "nice-to-have"
        },
        {
          "feature": "Extensible integration ecosystem",
          "priority": "must-have"
        },
        {
          "feature": "Admin UI and design system",
          "priority": "must-have"
        }
      ],
      "integrations": [
        "Payment providers",
        "Shipping integrations",
        "Third-party commerce APIs",
        "Custom provider system"
      ],
      "scale": "large",
      "domain": "e-commerce",
      "tech_stack": {
        "frontend": "React with Storybook, TypeScript",
        "backend": "Node.js with Express, TypeScript",
        "database": "Not specified in manifest (likely PostgreSQL based on typical Medusa deployments)",
        "infrastructure": "Medusa Cloud (managed), Docker-ready",
        "key_libraries": [
          "Express",
          "TypeScript",
          "React",
          "Jest",
          "SWC",
          "Rollup",
          "Storybook",
          "Testing Library"
        ]
      },
      "architecture_pattern": "microservices",
      "lessons": [
        "Monorepo workspace structure with modular packages enables pluggable commerce modules and provider system for maximum extensibility",
        "Separation of core framework, modules, admin UI, and CLI into distinct packages allows independent versioning and selective adoption",
        "Comprehensive test and build tooling (Jest, SWC, Rollup) across workspace ensures quality and performance at scale",
        "Design system and component library (Storybook) shared across admin and integrations promotes consistency in commerce UX"
      ]
    }
