  "metadata": {
    "github_url": "https://github.com/safytech/ulearn",
    "stars": 689,
    "domain": "edtech",
    "primary_language": "PHP",
    "architecture_pattern": "monolith",
    "tech_stack": {
      "frontend": "ReactJS 16.9 with React Router, Bootstrap 4",
      "backend": "Laravel 5.8 (PHP)",
      "database": "MySQL (via Laravel Eloquent/Artisan migrations)",
      "infrastructure": "Laravel Mix (Webpack) for asset bundling",
      "key_libraries": [
        "react",
        "react-dom",
        "react-router-dom",
        "axios",
        "laravel-mix",
        "bootstrap",
        "jquery",
        "@fortawesome/react-fontawesome",
        "sass"
      ]
    },
    "raw_profile": {
      "project_name": "ULEARN",
      "problem_statement": "ULEARN provides a free, open-source Learning Management System (LMS) that enables educators to create and manage online courses with multi-role support for admins, instructors, and students.",
      "target_users": [
        "online educators and instructors",
        "students",
        "e-learning platform administrators",
        "educational institutions"
      ],
      "core_features": [
        {
          "feature": "Course creation and management with multimedia curriculum (audio, video, document, text)",
          "priority": "must-have"
        },
        {
          "feature": "Multi-role access control (Admin, Instructor, Student)",
          "priority": "must-have"
        },
        {
          "feature": "Payment gateway integration for course purchases",
          "priority": "must-have"
        },
        {
          "feature": "Social login authentication",
          "priority": "nice-to-have"
        },
        {
          "feature": "Instructor credits and earnings module",
          "priority": "must-have"
        },
        {
          "feature": "Blog and page management (CMS)",
          "priority": "nice-to-have"
        },
        {
          "feature": "SEO-friendly responsive frontend website",
          "priority": "nice-to-have"
        },
        {
          "feature": "Interactive ReactJS-powered course learning page",
          "priority": "must-have"
        }
      ],
      "integrations": [
        "social login providers (OAuth)",
        "payment gateway (unspecified)"
      ],
      "scale": "small",
      "domain": "edtech",
      "tech_stack": {
        "frontend": "ReactJS 16.9 with React Router, Bootstrap 4",
        "backend": "Laravel 5.8 (PHP)",
        "database": "MySQL (via Laravel Eloquent/Artisan migrations)",
        "infrastructure": "Laravel Mix (Webpack) for asset bundling",
        "key_libraries": [
          "react",
          "react-dom",
          "react-router-dom",
          "axios",
          "laravel-mix",
          "bootstrap",
          "jquery",
          "@fortawesome/react-fontawesome",
          "sass"
        ]
      },
      "architecture_pattern": "monolith",
      "lessons": [
        "Hybrid rendering approach: Laravel handles server-side routing and blade templates while ReactJS is used selectively for interactive course-learning pages rather than as a full SPA.",
        "Laravel Mix is used as the build pipeline abstraction over Webpack, simplifying asset compilation for a PHP-centric team.",
        "Multi-role RBAC (Admin, Instructor, Student) is baked into the core design, reflecting the hierarchical nature of LMS platforms.",
        "The project relies on Laravel's Artisan migrations and seeders for schema management and initial data population, enabling quick local setup."
      ]
    }
  }
