# ─────────────────────────────────────────────
# Project Inception — Backend Environment
# Copy this file to .env and fill in all values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# Your Anthropic API key (required).
# All Claude agent calls (requirement, architecture, tech stack, estimation,
# report generation, prototype generation) use this key.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Your OpenAI API key (required for RAG corpus).
# Used only to embed reference documents and queries via text-embedding-3-small.
# If you skip `python -m rag.seed`, agents still run — RAG lookups fail silently.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Your Supabase project REST URL (required).
# Found in: Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase service role key (required).
# Found in: Supabase dashboard → Project Settings → API → service_role key
# Keep this secret — it bypasses Row Level Security.
SUPABASE_SERVICE_KEY=eyJ...

# Comma-separated list of allowed CORS origins (required).
# Local dev: http://localhost:5173
# Production: add your Vercel deployment URL
CORS_ORIGINS=http://localhost:5173

# GitHub personal access token (optional).
# Raises GitHub API rate limit from 60 to 5000 requests/hour during RAG seeding.
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
