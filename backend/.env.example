# ─────────────────────────────────────────────
# Project Inception — Backend Environment
# Copy this file to .env and fill in values.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Required for all modes ───────────────────

# Comma-separated list of allowed CORS origins.
# Local dev: http://localhost:5173
# Production: your Vercel deployment URL
CORS_ORIGINS=http://localhost:5173

# ── Mode switch ──────────────────────────────

# false (default): rule-based agents — no AI credits, no database, nothing stored.
# true:            Claude-powered agents — requires the keys below + Supabase RAG corpus.
DEMO_MODE=false

# ── Required only when DEMO_MODE=true ────────

# Anthropic API key. Server refuses to start with DEMO_MODE=true if missing.
# Get one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI API key (RAG corpus embeddings).
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Supabase project for the pgvector RAG corpus (DEMO_MODE only — unused otherwise).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Optional ─────────────────────────────────

# GitHub personal access token — raises GitHub API rate limit during RAG seeding.
GITHUB_TOKEN=
