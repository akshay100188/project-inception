# ─────────────────────────────────────────────
# Project Inception — Frontend Environment
# Copy this file to .env.local and fill in values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# URL of the backend API (required).
# Local dev:  http://localhost:8000
# Production: your backend host URL (e.g. https://your-backend.up.railway.app)
VITE_API_URL=http://localhost:8000

# ── Analytics (optional) ─────────────────────

# PostHog project API key — enables anonymous usage analytics.
# Leave blank to disable analytics entirely (no errors thrown).
VITE_POSTHOG_KEY=

# PostHog ingest host. Default is US cloud.
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Umami analytics (optional) — both must be set or it stays dormant.
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
