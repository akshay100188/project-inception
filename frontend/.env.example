# ─────────────────────────────────────────────
# Project Inception — Frontend Environment
# Copy this file to .env.local and fill in all values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Your Supabase project REST URL (required).
# Found in: Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon (public) key (required).
# Found in: Supabase dashboard → Project Settings → API → anon key
# Safe to include in frontend code — Row Level Security enforces data access.
VITE_SUPABASE_ANON_KEY=eyJ...

# URL of the backend API (required).
# Local dev:  http://localhost:8000
# Production: https://your-backend.railway.app
VITE_API_URL=http://localhost:8000

# ── Analytics (optional) ─────────────────────

# PostHog project API key — enables usage analytics.
# Create a free account at https://posthog.com, then copy the key from
# Project Settings → Project API Key.
# Leave blank to disable analytics entirely (no errors thrown).
VITE_POSTHOG_KEY=

# PostHog ingest host. Default is US cloud — change to https://eu.i.posthog.com
# if you want data stored in the EU, or your self-hosted PostHog URL.
VITE_POSTHOG_HOST=https://us.i.posthog.com
